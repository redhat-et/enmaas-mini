#!/usr/bin/env bash
# Activate the already prepared PriceTag deployment without changing other services.
set -euo pipefail
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/common/lib.sh
source "${SCRIPT_DIR}/../common/lib.sh"
require_root
readonly DEPLOY_DIR=/etc/praxis-pricetag
readonly PROBE_IMAGE=docker.io/library/python@sha256:519591d6871b7bc437060736b9f7456b8731f1499a57e22e6c285135ae657bf7
adopt_existing_database=0
if [[ "${1:-}" == --adopt-existing-database && "$#" == 1 ]]; then
  adopt_existing_database=1
elif [[ "$#" != 0 ]]; then
  die 'usage: scripts/pricetag/start [--adopt-existing-database]'
fi
[[ -f "${DEPLOY_DIR}/bootstrap.json" ]] || die 'run scripts/pricetag/prepare.py first'
[[ -s "${DEPLOY_DIR}/m2m-secret" ]] || die 'MaaS/PriceTag shared secret is missing; prepare a fresh deployment'
uid="$(service_uid)"
units="/etc/containers/systemd/users/${uid}"
install -d -m 0755 "${units}"
external_database=0
[[ -f "${DEPLOY_DIR}/external-maas-db.env" ]] && external_database=1
database_units=(pricetag-db.volume pricetag-db.container)
if [[ "${external_database}" == 1 ]]; then
  database_units=()
fi
for unit in pricetag.network "${database_units[@]}" pricetag-maas.container pricetag-metering.container pricetag-gateway.container; do
  install -m 0644 "${DEPLOY_DIR}/quadlets/${unit}" "${units}/${unit}"
done
if [[ -f "${DEPLOY_DIR}/quadlets/pricetag-mock.network" ]]; then
  install -m 0644 "${DEPLOY_DIR}/quadlets/pricetag-mock.network" "${units}/pricetag-mock.network"
fi
if [[ -f "${DEPLOY_DIR}/quadlets/pricetag-provider.container" ]]; then
  install -m 0644 "${DEPLOY_DIR}/quadlets/pricetag-provider.container" "${units}/pricetag-provider.container"
fi
semanage fcontext -a -t container_file_t '/etc/praxis-pricetag(/.*)?' 2>/dev/null ||
  semanage fcontext -m -t container_file_t '/etc/praxis-pricetag(/.*)?'
restorecon -R "${DEPLOY_DIR}"
as_service systemctl --user daemon-reload
if ! as_service podman secret inspect pricetag-m2m >/dev/null 2>&1; then
  as_service podman secret create pricetag-m2m "${DEPLOY_DIR}/m2m-secret" >/dev/null
fi
if [[ "${external_database}" == 1 ]]; then
  as_service systemctl --user start pricetag-network.service
else
  # Starting the database unit transitively starts pricetag-network.service:
  # the quadlet generator wires every Network= reference into the container
  # unit's dependencies, so the private network exists for the inspect and
  # the migration one-shot below.
  as_service systemctl --user start pricetag-db.service
  ready=0
  for ((attempt=0; attempt<60; attempt++)); do
    if as_service podman exec pricetag-db pg_isready >/dev/null 2>&1; then
      ready=1
      break
    fi
    sleep 1
  done
  [[ "${ready}" == 1 ]] || die 'PostgreSQL did not become ready'
fi
# Wait out — never kill — a migration one-shot left running by an
# interrupted prior start: CREATE INDEX CONCURRENTLY cannot be interrupted
# mid-run without risking an invalid index, and a legitimate build can
# outlast any bound on a large or busy database. A running leftover is
# allowed to finish — its advisory lock then serializes this start's own
# migration — and the ten-minute bound stops only this start attempt,
# loudly, leaving the container untouched for the operator to watch to
# completion. Exited leftovers hold no lease and are simply removed.
if as_service podman container exists pricetag-migrate; then
  echo 'Waiting for the MaaS schema migration container left by an interrupted start...' >&2
  state=true
  for ((waited = 0; waited < 600; waited += 5)); do
    state="$(as_service podman container inspect pricetag-migrate --format '{{.State.Running}}' 2>/dev/null)" ||
      die 'could not inspect the leftover MaaS schema migration container'
    [[ "${state}" == true ]] || break
    sleep 5
  done
  if [[ "${state}" == true ]]; then
    die 'the MaaS schema migration container left by an earlier start is still running after 10 minutes' \
      'and was left running: interrupting CREATE INDEX CONCURRENTLY can leave an invalid index, and a' \
      'build against a large or busy database can legitimately take longer. Let it finish (podman logs' \
      'pricetag-migrate, run as the service account, shows its progress), then run scripts/pricetag/start again.'
  fi
  as_service podman rm pricetag-migrate >/dev/null 2>&1 || true
fi
# A verify one-shot left behind by an interrupted start holds the
# migration's reserved address. Unlike the migration it is read-only,
# so any leftover is simply removed — before the address selection
# below, so it can neither skew that selection (podman 5 reports
# in-use addresses) nor collide with the fresh claim (podman 4.9
# does not).
as_service podman rm -f pricetag-verify >/dev/null 2>&1 || true
network_json="$(as_service podman network inspect --format json pricetag-private)" ||
  die 'could not inspect the private MaaS network'
service_addresses="$(printf '%s' "${network_json}" | python3 "${SCRIPT_DIR}/private-network.py" addresses)" ||
  die 'could not select private MaaS, gateway and metering addresses'
printf '%s' "${service_addresses}" | python3 "${SCRIPT_DIR}/private-network.py" configure \
  "${units}/pricetag-maas.container" "${units}/pricetag-gateway.container" \
  "${units}/pricetag-metering.container" ||
  die 'could not assign fixed private addresses to the MaaS, gateway and metering containers'
migrate_address="$(printf '%s' "${service_addresses}" | python3 -c 'import json, sys; print(json.load(sys.stdin)["migrate"])')" ||
  die 'could not select a private address for the MaaS schema migration'
as_service systemctl --user daemon-reload
if [[ "${external_database}" == 1 ]]; then
  python3 "${SCRIPT_DIR}/external-database" check ||
    die 'could not connect to the external PostgreSQL databases'
else
  pg_admin_user=postgres
  pg_admin_database=postgres
  if ! as_service podman exec pricetag-db psql -X -qAt -U postgres -d postgres -c 'SELECT 1' >/dev/null 2>&1; then
    pg_admin_user=metering
    pg_admin_database=metering
    is_superuser="$(as_service podman exec pricetag-db psql -X -qAt -U "${pg_admin_user}" \
      -d "${pg_admin_database}" -c 'SELECT rolsuper FROM pg_roles WHERE rolname=current_user' 2>/dev/null || true)"
    [[ "${is_superuser}" == t ]] || die 'PostgreSQL has neither the fresh-install admin nor the supported metering-superuser layout'
  fi
  if [[ ! -f "${DEPLOY_DIR}/postgres-bootstrap.done" ]]; then
    as_service podman exec -i pricetag-db psql -X -U "${pg_admin_user}" -d "${pg_admin_database}" -v ON_ERROR_STOP=1 \
      < "${DEPLOY_DIR}/initdb/10-create-databases.sql"
    install -m 0600 /dev/null "${DEPLOY_DIR}/postgres-bootstrap.done"
  fi
fi
# enmaas-api creates no tables at runtime: run its idempotent, advisory-locked
# migration as the service account before the API starts. The quadlet image
# reference is an immutable local ID, and the env file carries DATABASE_URL
# (with sslrootcert for verify-full external databases); database readiness
# is already established above. The image starts the API through CMD (no
# ENTRYPOINT), so the migration is a plain command override; --workdir pins
# the image's /srv/enmaas-api layout and PYTHONDONTWRITEBYTECODE=1 states
# the no-writes contract. The one-shot carries a stable name so the wait-out
# above can target it across starts. The explicit --ip address is disjoint
# from the service units' static addresses, so a container left behind by a
# failed cleanup cannot block them, and the run itself is the atomic claim —
# netavark rejects an address taken in between with a loud IPAM error.
maas_image="$(sed -n 's/^Image=//p' "${units}/pricetag-maas.container" | head -n 1)"
[[ -n "${maas_image}" ]] || die 'could not read the MaaS image from the prepared quadlet'
maas_ca_mount=()
if [[ -f "${DEPLOY_DIR}/external-ca.crt" ]]; then
  maas_ca_mount=(-v "${DEPLOY_DIR}/external-ca.crt:/etc/pricetag-external-ca.crt:ro")
fi
as_service podman run --rm --name pricetag-migrate --network pricetag-private --ip "${migrate_address}" \
  --workdir /srv/enmaas-api -e PYTHONDONTWRITEBYTECODE=1 \
  --env-file "${DEPLOY_DIR}/maas.env" "${maas_ca_mount[@]}" "${maas_image}" python -m app.migrate ||
  die 'MaaS schema migration failed'
# The migration's CREATE INDEX CONCURRENTLY IF NOT EXISTS cannot repair an
# index left invalid by an interrupted build — the rerun finds the catalog
# entry and skips it. An invalid index is ignored by the planner, so
# queries stay correct while labels lookups silently lose their index.
# Verify the end state through the same image, network, address and
# credentials the migration itself used, before the service starts; the
# check fails closed, and REINDEX INDEX CONCURRENTLY repairs the index.
# The address reuse is safe — the sequential --rm run above released its
# claim before returning. The check carries its own stable name so the
# removal above can clear a leftover from an interrupted start; it is
# read-only, so unlike the migration it needs no wait-out.
as_service podman run --rm --name pricetag-verify --network pricetag-private --ip "${migrate_address}" \
  --workdir /srv/enmaas-api -e PYTHONDONTWRITEBYTECODE=1 \
  --env-file "${DEPLOY_DIR}/maas.env" "${maas_ca_mount[@]}" "${maas_image}" \
  python -c 'import os, psycopg
with psycopg.connect(os.environ["DATABASE_URL"]) as connection:
    row = connection.execute("SELECT i.indisvalid FROM pg_index i"
                             " JOIN pg_class c ON i.indexrelid = c.oid"
                             " WHERE c.relname = %s",
                             ("idx_api_keys_labels_gin",)).fetchone()
if row is None or not row[0]:
    raise SystemExit("idx_api_keys_labels_gin is missing or invalid after the"
                     " migration; REINDEX INDEX CONCURRENTLY"
                     " idx_api_keys_labels_gin repairs it")' ||
  die 'MaaS schema verification failed'
as_service systemctl --user restart pricetag-maas.service
python3 - <<'PY'
import time, urllib.request
for attempt in range(60):
    try:
        with urllib.request.urlopen("http://127.0.0.1:18086/health", timeout=2) as r:
            if r.status == 200:
                break
    except OSError:
        pass
    time.sleep(1)
else:
    raise SystemExit("MaaS API did not become ready")
PY
admin_dir="$(<"${DEPLOY_DIR}/admin-directory")"
install -d -m 0700 "${admin_dir}"
if [[ ! -f "${admin_dir}/admin.key" ]]; then
  python3 "${SCRIPT_DIR}/maas-key" create --subject admin --admin --name admin \
    --url http://127.0.0.1:18086 --output "${admin_dir}/admin.key"
fi
as_service systemctl --user restart pricetag-metering.service
as_service podman run --rm --network pricetag-private "${PROBE_IMAGE}" python3 -c '
import time, urllib.request
for attempt in range(60):
    try:
        with urllib.request.urlopen("http://pricetag-metering:8080/ready", timeout=2) as r:
            if r.status == 200:
                break
    except OSError:
        pass
    time.sleep(1)
else:
    raise SystemExit("metering did not become ready")
'
python3 "${SCRIPT_DIR}/user" --subject admin --name Administrator --no-key --bootstrap-admin
if [[ ! -f "${DEPLOY_DIR}/bootstrap.done" ]]; then
  if [[ "${external_database}" == 1 ]]; then
    rows="$(python3 "${SCRIPT_DIR}/external-database" usage-count)"
  else
    rows="$(as_service podman exec pricetag-db psql -X -qAt -U metering -d metering -c 'SELECT count(*) FROM usage_events;')"
  fi
  if [[ "${rows}" != 0 && "${adopt_existing_database}" != 1 ]]; then
    die 'database already has usage; back it up, review schema and model prices, then use --adopt-existing-database'
  fi
  if ! python3 "${SCRIPT_DIR}/metering_admin.py" --bootstrap "${DEPLOY_DIR}/bootstrap.json"; then
    note 'PriceTag API initialization failed. Gateway startup stopped; inspect service status and rerun start.'
    die 'Keep the prepared files and keys. After fixing the cause, rerun sudo scripts/pricetag/start; do not rerun install or prepare.py.'
  fi
  install -m 0600 /dev/null "${DEPLOY_DIR}/bootstrap.done"
fi
if [[ -f "${DEPLOY_DIR}/quadlets/pricetag-provider.container" ]]; then
  as_service systemctl --user start pricetag-provider.service
fi
as_service systemctl --user restart pricetag-gateway.service
python3 - "${DEPLOY_DIR}/ca.pem" <<'PY'
import ssl, sys, time, urllib.request
context = ssl.create_default_context(cafile=sys.argv[1])
for attempt in range(60):
    try:
        with urllib.request.urlopen('https://localhost:8443/login', context=context, timeout=2) as response:
            if response.status == 200:
                break
    except OSError:
        pass
    time.sleep(.5)
else:
    raise SystemExit('gateway HTTPS did not become ready')
PY
if [[ ! -f "${DEPLOY_DIR}/sample-users" ]] || [[ "$(cat "${DEPLOY_DIR}/sample-users")" == yes ]]; then
  for subject in alice bob; do
    if [[ ! -f "${admin_dir}/${subject}.key" ]]; then
      python3 "${SCRIPT_DIR}/user" --subject "${subject}" --name "${subject^}" \
        --output "${admin_dir}/${subject}.key"
    fi
  done
fi
note 'Praxis, MaaS and PriceTag are ready. Inference and dashboard login use finite MaaS keys.'
note "Copy /etc/praxis-pricetag/ca.pem to clients; distribute keys from ${admin_dir} securely."
