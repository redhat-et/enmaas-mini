#!/usr/bin/env bash
set -euo pipefail
# bootstrap — idempotent laptop installer for enmaas-mini (Darwin applehv, no Tailscale/Orca)
# Wraps scripts/laptop/deploy,teardown with preflight, idempotency, and menu.
# Usage: ./scripts/laptop/bootstrap [--yes] [--from-scratch] [--with-llm-katan] [--run-tests] [--wipe] [--status]
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
DEPLOY="$ROOT/scripts/laptop/deploy"
TEARDOWN="$ROOT/scripts/laptop/teardown"
DEPLOY_DIR="$HOME/.local/share/enmaas-mini/laptop"
ADMIN_DIR="$HOME/praxis-laptop-admin"
COMPOSE="$DEPLOY_DIR/compose.laptop.yaml"
LOCK="/tmp/praxis-laptop-deploy.lock"
YES=""
FROM_SCRATCH=""
WITH_LLM=""
RUN_TESTS=""
DO_WIPE=""
DO_STATUS=""

usage(){ echo "Usage: $0 [--yes] [--from-scratch] [--with-llm-katan] [--run-tests] [--wipe] [--status]"; exit 0; }
for a in "$@"; do case "$a" in
  --yes) YES=--yes;;
  --from-scratch) FROM_SCRATCH=--from-scratch;;
  --with-llm-katan) WITH_LLM="--llm-katan echo";;
  --run-tests) RUN_TESTS=1;;
  --wipe) DO_WIPE=1;;
  --status) DO_STATUS=1;;
  -h|--help) usage;;
  *) echo "unknown $a" >&2; usage;;
esac; done

need(){ local n=$1 v=$2 inst=$3; if ! command -v "$n" >/dev/null 2>&1; then echo "missing $n $v → $inst" >&2; MISSING=1; fi; }
check_deps(){
  MISSING=""
  need podman "≥4.6" "brew install podman"
  need python3 "3.12" "brew install python@3.12"
  need openssl "" "brew install openssl"
  if ! command -v podman-compose >/dev/null 2>&1 && ! podman compose version >/dev/null 2>&1; then echo "missing podman-compose → brew install podman-compose" >&2; MISSING=1; fi
  if [[ -n "$MISSING" ]]; then
    if [[ -z "$YES" && -t 0 ]]; then read -rp "Install missing via brew? [y/N] " a; [[ "$a" == y* ]] && brew install podman podman-compose mkcert nss || true; else echo "run: brew install podman podman-compose mkcert nss" >&2; exit 1; fi
  fi
  podman --version | grep -Eq "podman version (4\.[6-9]|[5-9]\.)" || { echo "podman ≥4.6 required" >&2; exit 1; }
}

ensure_machine(){
  if ! podman machine list --format "{{.Name}}" 2>/dev/null | grep -q "podman-machine-default\|applehv"; then
    echo "podman machine not found → podman machine init --cpus 10 --memory 16384 --disk-size 93" >&2
    if [[ -z "$YES" ]]; then read -rp "Create it? [y/N] " a; [[ "$a" == y* ]] || exit 1; fi
    podman machine init --cpus 10 --memory 16384 --disk-size 93 --now
  fi
  podman machine start 2>/dev/null || true
}

is_deployed(){ [[ -f "$COMPOSE" ]] && podman ps --format "{{.Names}}" 2>/dev/null | grep -q "pricetag-db"; }

status(){
  echo "— status —"
  podman machine list 2>&1 | head -n 5
  podman ps --format "table {{.Names}}\t{{.Status}}" 2>&1 | grep -E "NAMES|pricetag"
  if [[ -f "$DEPLOY_DIR/ca.pem" ]]; then echo "CA: $DEPLOY_DIR/ca.pem"; fi
  if [[ -f "$COMPOSE" ]]; then curl -k -s -w "Gateway https://localhost:8443/login %{http_code}\n" https://localhost:8443/login -o /dev/null 2>&1 | tail -n 1; else echo "not deployed"; fi
  podman volume ls 2>&1 | grep -E "pricetag|NAME" | head
  exit 0
}

do_install(){
  check_deps; ensure_machine
  if is_deployed; then
    echo "already deployed $COMPOSE $(podman ps --format "{{.Names}} {{.Status}}" | grep pricetag-db | head)"
    if [[ -z "$FROM_SCRATCH" ]]; then
      if [[ -n "$YES" ]]; then echo "use --from-scratch to wipe or --wipe to teardown"; exit 0; fi
      read -rp "Wipe and re-install? [y/N] " a; [[ "$a" == y* ]] || { echo "leaving as is"; exit 0; }
      FROM_SCRATCH=--from-scratch
    fi
  fi
  # deploy is idempotent via flock $LOCK, disk ≥20GiB gate, postgres volume pre-create, maas-db-url absolute
  exec python3 "$DEPLOY" --mode mock --hostname localhost $FROM_SCRATCH $YES $WITH_LLM
}

do_tests(){
  CA="$DEPLOY_DIR/ca.pem"; [[ -f "$CA" ]] || CA="$ADMIN_DIR/tls/ca.pem"
  echo "— perf smoke 20×200 —"
  # Laptop has no sudo/praxis-svc, so create bench user directly via gateway (host 127.0.0.1:18086 403 on Darwin NAT)
  rm -rf /tmp/perf-bootstrap; mkdir -p /tmp/perf-bootstrap
  SUBJ=perf-bootstrap-00
  TOKEN=$(podman exec pricetag-gateway curl -s -X POST -H "X-MaaS-Username: $SUBJ" -H "X-MaaS-Group: [\"system:authenticated\"]" -H "Content-Type: application/json" -d "{\"name\":\"$SUBJ\",\"expiresIn\":\"90d\"}" http://pricetag-maas:8080/v1/api-keys 2>/dev/null | python3 -c "import sys,json;print(json.load(sys.stdin).get(\"key\",\"\"))")
  if [[ -z "$TOKEN" ]]; then echo "perf user create failed (MaaS not ready)"; return 1; fi
  echo "$TOKEN" > /tmp/perf-bootstrap/$SUBJ.key; chmod 600 /tmp/perf-bootstrap/$SUBJ.key
  MGMT=$(cat "$DEPLOY_DIR/management-secret"); curl -s -X PUT -H "Authorization: Bearer $MGMT" -H "Content-Type: application/json" -d "{\"subject\":\"$SUBJ\",\"name\":\"$SUBJ\"}" http://127.0.0.1:18087/api/v1/management/users >/dev/null; curl -s -X PUT -H "Authorization: Bearer $MGMT" -H "Content-Type: application/json" -d "{\"subject\":\"$SUBJ\",\"monthly_usd\":100}" http://127.0.0.1:18087/api/v1/management/budgets >/dev/null
  echo "bench user $SUBJ ready"
  rm -f /tmp/perf-bootstrap.json
  python3 "$ROOT/scripts/pricetag/perf" run --model fixture --url https://localhost:8443 --ca "$CA" --tokens /tmp/perf-bootstrap --concurrency 1 --requests 20 --think 0 --output /tmp/perf-bootstrap.json 2>&1 | tail -n 5
  python3 "$ROOT/scripts/pricetag/perf" verify --report /tmp/perf-bootstrap.json --database pricetag-db 2>&1 | tail -n 5
}

[[ -n "$DO_STATUS" ]] && status
[[ -n "$DO_WIPE" ]] && { python3 "$TEARDOWN" --purge-volumes --yes; echo "wiped"; exit 0; }

if [[ -n "$RUN_TESTS" ]]; then do_install; do_tests; exit 0; fi
if [[ $# -gt 0 ]]; then do_install; exit 0; fi

# interactive menu
check_deps; ensure_machine
while true; do
  echo ""
  echo "1) install (idempotent, keep volumes)"
  echo "2) reinstall --from-scratch (purge volumes, 5×healthy)"
  echo "3) wipe (teardown --purge-volumes)"
  echo "4) status (machine, ps, curl -k, volumes)"
  echo "5) run tests (20×200 2+3=5 PASS)"
  echo "6) logs (podman-compose logs -f)"
  echo "q) quit"
  read -rp "choice: " c
  case "$c" in
    1) python3 "$DEPLOY" --mode mock --hostname localhost --yes $WITH_LLM;;
    2) python3 "$DEPLOY" --mode mock --hostname localhost --from-scratch --yes $WITH_LLM;;
    3) python3 "$TEARDOWN" --purge-volumes --yes;;
    4) status;;
    5) do_tests;;
    6) podman-compose -f "$COMPOSE" logs -f 2>&1 | head -n 100;;
    q|Q) exit 0;;
    *) echo "unknown";;
  esac
done
