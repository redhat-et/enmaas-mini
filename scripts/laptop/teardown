# ---------------------------------------------------------------------------
# Logging & helpers (mirror lib.sh semantics)
# ---------------------------------------------------------------------------

def die(msg: str) -> None:
    print(f"error: {msg}", file=sys.stderr, flush=True)
    if LOG_FD:
        LOG_FD.write(f"error: {msg}\n")
        LOG_FD.flush()
    sys.exit(1)


def note(msg: str) -> None:
    print(msg, flush=True)
    if LOG_FD:
        LOG_FD.write(msg + "\n")
        LOG_FD.flush()


def log(msg: str) -> None:
    print(msg, flush=True)
    if LOG_FD:
        LOG_FD.write(msg + "\n")
        LOG_FD.flush()


def warn(msg: str) -> None:
    print(f"WARN: {msg}", flush=True)
    if LOG_FD:
        LOG_FD.write(f"WARN: {msg}\n")
        LOG_FD.flush()


def open_log(directory: str = "/tmp") -> Path:
    global LOG_FD, LOG_PATH
    Path(directory).mkdir(parents=True, exist_ok=True)
    fd, name = tempfile.mkstemp(prefix="praxis-laptop-teardown-", suffix=".log", dir=directory)
    LOG_PATH = Path(name)
    LOG_FD = os.fdopen(fd, "w", buffering=1)
    os.chmod(LOG_PATH, 0o600)
    log(f"Detailed log: {LOG_PATH}")
    return LOG_PATH


def run(
    cmd: list[str | Path],
    label: str | None = None,
    check: bool = False,
    capture: bool = False,
    cwd: str | Path = "/tmp",
    timeout: int = 30,
) -> subprocess.CompletedProcess | None:
    cmd_str = [str(c) for c in cmd]
    if LOG_FD:
        LOG_FD.write("+ " + " ".join(cmd_str) + "\n")
        LOG_FD.flush()
    if label and not capture:
        print(f"  {label}...", flush=True)
    try:
        result = subprocess.run(
            cmd_str,
            cwd=str(cwd),
            text=True,
            capture_output=capture,
            timeout=timeout,
        )
        if label and not capture:
            if result.returncode == 0:
                print("  OK", flush=True)
            else:
                print(f"  (exit {result.returncode}, continuing - idempotent)", flush=True)
        if check and result.returncode != 0:
            raise subprocess.CalledProcessError(result.returncode, cmd_str)
        return result
    except FileNotFoundError:
        if label:
            print(f"  SKIP: command not found: {cmd_str[0]}", flush=True)
        return None
    except subprocess.TimeoutExpired:
        warn(f"command timed out: {' '.join(cmd_str)}")
        return None


# ---------------------------------------------------------------------------
# Platform detection & lib.sh mirrors
# ---------------------------------------------------------------------------

def is_rhel() -> bool:
    if sys.platform != "linux":
        return False
    p = Path("/etc/os-release")
    if not p.is_file():
        return False
    try:
        return bool(re.search(r'^ID="?rhel"?$', p.read_text(), re.M))
    except OSError:
        return False


def require_root() -> None:
    if os.geteuid() != 0:
        die("run this command as root (RHEL Quadlet teardown requires sudo)")


def require_command(name: str) -> None:
    if shutil.which(name) is None:
        die(f"required command not found: {name}")


def gateway_lock_path(owner: str) -> Path:
    if not re.fullmatch(r"[a-z_][a-z0-9_-]*", owner):
        die(f"invalid service account: {owner}")
    if owner == "praxis-svc":
        return Path("/run/lock/praxis-gateway.lock")
    return Path(f"/run/lock/praxis-gateway-{owner}.lock")


def try_service_uid(user: str | None = None) -> int | None:
    """Return uid or None if service account missing (no die, for optional checks)."""
    name = user or RHEL_SERVICE_USER
    try:
        return pwd.getpwnam(name).pw_uid
    except KeyError:
        return None


def service_uid(user: str | None = None) -> int:
    uid = try_service_uid(user)
    if uid is None:
        die(f"service account {user or RHEL_SERVICE_USER} does not exist; run install --prepare first")
    return uid


def service_home(user: str | None = None) -> Path:
    import pwd as _pwd
    name = user or RHEL_SERVICE_USER
    try:
        return Path(_pwd.getpwnam(name).pw_dir)
    except KeyError:
        die(f"could not resolve {name} home")


def vllm_uses_praxis_network(root: Path = Path("/"), uid: int | None = None) -> bool:
    """Mirror lib.sh vllm_uses_praxis_network: preserve praxis.network if vLLM owns it."""
    if uid is None:
        uid = try_service_uid()
        if uid is None:
            return False
    unit = root / f"etc/containers/systemd/users/{uid}/praxis-vllm.container"
    state = root / "etc/praxis-vllm"
    if not unit.is_file() or not (state / "manifest").is_file():
        return False
    try:
        content = unit.read_text()
        return "Network=praxis.network" in content
    except OSError:
        return False


def as_service_args() -> list[str]:
    """Return prefix for running as service user (runuser wrapper)."""
    uid = service_uid()
    home = service_home()
    return [
        "runuser", "-u", RHEL_SERVICE_USER, "--", "env",
        f"HOME={home}", f"XDG_RUNTIME_DIR=/run/user/{uid}",
        f"DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/{uid}/bus",
    ]


def validate_owned_path(path: Path, deploy_dir: Path | None = None, admin_dir: Path | None = None) -> None:
    """Validate path is managed and safe to remove (mirror lib.sh validate_owned_path).

    For Darwin: allow paths under deploy_dir, admin_dir, COMPOSE file, and known
    systemd unit locations. For RHEL: strict allowlist mirroring lib.sh but for
    pricetag resources.
    """
    # Normalize
    try:
        resolved = path.resolve()
    except OSError:
        resolved = path

    # Allow deploy/admin trees (with strict parent check to prevent traversal)
    allowed_prefixes: list[Path] = []
    if deploy_dir:
        allowed_prefixes.append(deploy_dir.resolve() if deploy_dir.exists() else deploy_dir)
    if admin_dir:
        allowed_prefixes.append(admin_dir.resolve() if admin_dir.exists() else admin_dir)
    # RHEL fixed paths
    allowed_prefixes.extend([RHEL_DEPLOY, RHEL_ADMIN, RHEL_INPUTS])
    # Also allow compose file and lock files
    allowed_prefixes.extend([DEFAULT_COMPOSE_FILE, LOCK_PATH, TEARDOWN_LOCK])
    # Systemd units for RHEL
    try:
        uid = service_uid()
        allowed_prefixes.append(Path(f"/etc/containers/systemd/users/{uid}"))
        allowed_prefixes.append(Path(f"/etc/containers/systemd/users/{uid}/pricetag.network"))
        allowed_prefixes.append(Path(f"/etc/containers/systemd/users/{uid}/pricetag-db.volume"))
        for unit in ("pricetag-db", "pricetag-maas", "pricetag-metering", "pricetag-gateway",
                     "pricetag-provider", "pricetag-mock"):
            allowed_prefixes.append(Path(f"/etc/containers/systemd/users/{uid}/{unit}.container"))
            allowed_prefixes.append(Path(f"/etc/containers/systemd/users/{uid}/{unit}.network"))
    except SystemExit:
        pass

    # Check if path or its parent is under an allowed prefix, or is the allowed path itself
    # Also allow any file under RHEL_DEPLOY / RHEL_ADMIN (they are managed trees)
    for prefix in allowed_prefixes:
        try:
            # Exact match
            if resolved == prefix.resolve() if prefix.exists() else resolved == prefix:
                return
            # Under prefix
            if resolved.is_relative_to(prefix.resolve() if prefix.exists() else prefix):
                return
            # For non-existent deploy_dir/admin_dir, check string prefix (pre-removal)
            if deploy_dir and str(resolved).startswith(str(deploy_dir)):
                return
            if admin_dir and str(resolved).startswith(str(admin_dir)):
                return
        except (OSError, ValueError):
            continue
        # String fallback for paths that don't exist yet or are symlinks
        if str(resolved).startswith(str(prefix)):
            return

    # Additional allowlist for known pricetag files (mirror lib.sh but for pricetag)
    allowed_exact = {
        RHEL_DEPLOY / "ca.pem",
        RHEL_DEPLOY / "bootstrap.json",
        RHEL_DEPLOY / "m2m-secret",
        RHEL_DEPLOY / "management-secret",
        RHEL_DEPLOY / "postgres-bootstrap.done",
        RHEL_DEPLOY / "bootstrap.done",
        DEFAULT_COMPOSE_FILE,
        ROOT / "compose.laptop.yaml",
    }
    if resolved in allowed_exact or path in allowed_exact:
        return

    # If we reach here, check if it's under a known managed root
    # For Darwin laptop: anything under $HOME is considered owned if it matches deploy/admin
    # For safety, refuse paths like /, /etc, /usr, /var, /home that are not specific
    dangerous = [Path("/"), Path("/etc"), Path("/usr"), Path("/var"), Path("/bin"), Path("/sbin")]
    if resolved in dangerous:
        die(f"refusing to remove unmanaged system path: {path}")

    # If path is under HOME and looks like laptop deploy, allow
    home = Path.home()
    try:
        if resolved.is_relative_to(home):
            # Only allow if it's deploy/admin or their children
            if deploy_dir and str(resolved).startswith(str(deploy_dir)):
                return
            if admin_dir and str(resolved).startswith(str(admin_dir)):
                return
            # Also allow $HOME/praxis-laptop-admin explicitly
            if str(resolved).startswith(str(home / "praxis-laptop-admin")):
                return
            if str(resolved).startswith(str(home / ".local/share/enmaas-mini")):
                return
    except ValueError:
        pass

    # If none matched, it's unmanaged - but for idempotent teardown we treat
    # non-managed paths as already clean rather than error, unless it's a system path.
    # This matches idempotent behavior: don't fail if file not in manifest.
    # Only die if it's clearly a managed location that drifted.
    # For now, allow removal if it's inside deploy/admin, otherwise warn.
    if deploy_dir and admin_dir:
        # If path is not under deploy/admin and not a known RHEL path, it's not ours
        warn(f"path not in managed allowlist, skipping: {path}")
        raise ValueError(f"unmanaged path: {path}")


def verify_managed_manifest_like(deploy_dir: Path) -> bool:
    """Verify deploy dir contents haven't drifted (best-effort, idempotent).

    For laptop, there is no manifest file, but we can check that deploy_dir
    contains expected laptop files and no unexpected suid/world-writable perms.
    Returns True if verification passed or dir absent (idempotent), False if drift
    detected (caller should warn but continue for teardown).
    """
    if not deploy_dir.exists():
        return True
    if deploy_dir.is_symlink():
        warn(f"deploy dir is symlink, refusing automatic removal: {deploy_dir}")
        return False
    try:
        st = deploy_dir.stat()
        if st.st_uid != os.getuid() and os.geteuid() != 0:
            warn(f"deploy dir owned by {st.st_uid}, expected {os.getuid()}: {deploy_dir}")
            return False
        if st.st_mode & 0o022:
            warn(f"deploy dir is group/world-writable: {deploy_dir}")
            return False
    except OSError as e:
        warn(f"could not stat deploy dir: {e}")
        return False
    return True


def detect_compose() -> list[str] | None:
    """Detect compose engine: prefer podman-compose, then podman compose, then docker."""
    if shutil.which("podman-compose"):
        return ["podman-compose"]
    try:
        r = subprocess.run(["podman", "compose", "version"], capture_output=True, text=True, timeout=10)
        if r.returncode == 0:
            return ["podman", "compose"]
    except FileNotFoundError:
        pass
    try:
        r = subprocess.run(["docker", "compose", "version"], capture_output=True, text=True, timeout=10)
        if r.returncode == 0:
            return ["docker", "compose"]
    except FileNotFoundError:
        pass
    if shutil.which("docker-compose"):
        return ["docker-compose"]
    return None


def engine_bin() -> str:
    if shutil.which("podman"):
        return "podman"
    if shutil.which("docker"):
        return "docker"
    return "podman"


# ---------------------------------------------------------------------------
