# compose.laptop.yaml.j2 - MBP (Darwin + Podman machine applehv) deployment
# Generated by scripts/laptop/deploy via Jinja2; also usable as reference.
#
# Networks:
#   pricetag-private  10.77.0.0/24  app DB + MaaS + metering + gateway
#   pricetag-mock     10.78.0.0/24  synthetic provider (isolated from private except via gateway)
#
# Secrets:
#   pricetag-m2m      internal metering auth (file: ./m2m-secret)
#   pricetag-mock-ui-v1 synthetic provider credential (env CUSTOM_MOCK_API_KEY)
#                     Must match mock-guard: Secret=pricetag-mock-ui-v1,type=env,target=CUSTOM_MOCK_API_KEY
#     See: tests/pricetag/mock-guard.cjs
#
# Postgres:
#   Hardened placeholder (production RHEL): {{ postgres_hardened_placeholder }}
#   Laptop community image:                  {{ postgres_image }}
#
# MaaS:
#   arm64 image required for Apple Silicon.  {{ maas_image }}
#   Standalone mode: MAAS_RUNTIME_MODE=standalone, MAAS_SUBSCRIPTION_MODE=standalone
#   Trusted proxies include gateway + metering + db on 10.77.0.0/24.
#
# Gateway:
#   Config rendered via scripts/pricetag/gateway.py from scripts/common/unified_config.py.
#   insecure: allow_private_endpoints + allow_private_upstreams + insecure allow_private
#   TLS: ./gateway/tls.pem + tls-key.pem (lab-tls or openssl fallback)
#
# LLM-Katan:
#   Image: ghcr.io/yossiovadia/llm-katan:0.22.0  backend echo
#   Providers: openai,anthropic on :8000
#   Env: configs/laptop/llm-katan.env (synthetic keys, failure flags disabled)
#   Dashboard published only on 127.0.0.1:8000 (host loopback), not 0.0.0.0.
#   Known gaps (see scripts/laptop/shims/README.md):
#     /v1/responses and /v1/messages/count_tokens are not implemented by llm-katan;
#     perf harness uses only /v1/chat/completions + /v1/messages.
#
# To start: podman-compose -f compose.laptop.yaml up -d  OR  docker compose -f compose.laptop.yaml up -d
# To verify: scripts/laptop/deploy --verify  OR  podman-compose logs -f
# Teardown: scripts/laptop/teardown --purge-volumes
# Generated: {{ generated_at }}  Host: {{ hostname }}  Mode: {{ mode }}  LLM-Katan: {{ llm_katan }}  Arch: {{ arch }}

services:
  pricetag-db:
    # Standard postgres for laptop; hardened would be {{ postgres_hardened_placeholder }}
    # postgres_hardened_placeholder is the production RHEL registry reference (not yet published for laptop).
    image: {{ postgres_image }}
    container_name: pricetag-db
    environment:
      POSTGRES_USER: postgres
      POSTGRES_DB: postgres
      POSTGRES_PASSWORD: "{{ postgres_password }}"
      TZ: UTC
      PGTZ: UTC
    volumes:
      - pricetag-data:/var/lib/postgresql/data
      - {{ deploy_dir | default("~/.local/share/enmaas-mini/laptop") }}/initdb:/docker-entrypoint-initdb.d:ro
    networks:
      pricetag-private:
        ipv4_address: 10.77.0.2
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres -d postgres"]
      interval: 5s
      timeout: 3s
      retries: 20
      start_period: 10s
    restart: unless-stopped
    tmpfs:
      - /var/run/postgresql:rw,mode=3775
      - /tmp
    read_only: false
    # Postgres needs to chown its data dir on init; do not drop caps that block it.
    # Keep capabilities; hardened production will run with explicit volume ownership pre-created.

  llm-katan:
    image: {{ llm_katan_image | default("ghcr.io/yossiovadia/llm-katan:0.22.0") }}
    container_name: pricetag-provider
    # Echo backend: no GPU, no torch, instant startup. Providers: openai,anthropic on :8000.
    # Keep the container name pricetag-provider for mock-guard compatibility (endpoint pricetag-provider:18080/18081 == pricetag-provider:8000).
    # llm-katan exposes both providers on the same port with path-based routing.
    # Isolated on pricetag-mock only; gateway is the sole bridge to pricetag-private.
    command:
      - --model
      - fixture
      - --backend
      - echo
      - --providers
      - openai,anthropic
      - --port
      - "8000"
      - --host
      - "0.0.0.0"
      - --api-keys
      - "openai=synthetic-openai,anthropic=synthetic-anthropic"
      - --error-rate
      - "0.0"
      - --latency-ms
      - "0"
      - --timeout-after
      - "0"
      - --rate-limit-after
      - "0"
      - --max-inflight
      - "0"
      - --chunk-delay-ms
      - "0"
      - --ttft-ms
      - "0"
      - --itl-ms
      - "0"
    env_file:
      - {{ deploy_dir | default("~/.local/share/enmaas-mini/laptop") }}/llm-katan.env
    environment:
      # Synthetic credentials - must match gateway credential_injection (mock-guard):
      # Secret=pricetag-mock-ui-v1,type=env,target=CUSTOM_MOCK_API_KEY is represented here as env.
      CUSTOM_MOCK_API_KEY: synthetic-anthropic
      OPENAI_API_KEY: synthetic-openai
    networks:
      pricetag-mock:
        ipv4_address: 10.78.0.10
    ports:
      # Dashboard + provider APIs: loopback only, not 0.0.0.0. External access via gateway :8443 only.
      - "127.0.0.1:8000:8000"
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://127.0.0.1:8000/health || wget -qO- http://127.0.0.1:8000/health || python3 -c \"import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=2).read()\""]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 15s
    read_only: false
    cap_drop:
      - ALL
    # Note: llm-katan echo is variable word-count tokens (not 2+3=5). See shims/README.md.
    # Failure injection disabled by default; enable per-test via --error-rate etc.

  # Optional responses shim sidecar - uncomment when ENABLE_RESPONSES_SHIM=1
  # See scripts/laptop/shims/README.md and shims/responses_shim.py
  # responses-shim:
  #   image: docker.io/library/python:3.12-slim
  #   container_name: responses-shim
  #   volumes:
  #     - ./shims:/shims:ro
  #   command: ["python3", "/shims/responses_shim.py", "--listen", "0.0.0.0:18090", "--upstream", "http://pricetag-provider:8000"]
  #   networks:
  #     pricetag-mock:
  #   depends_on:
  #     llm-katan:
  #       condition: service_healthy
  #   healthcheck:
  #     test: ["CMD-SHELL", "curl -fsS http://127.0.0.1:18090/health || wget -qO- http://127.0.0.1:18090/health"]
  #     interval: 10s
  #     timeout: 3s
  #     retries: 5
  #   restart: unless-stopped

  pricetag-maas:
    image: {{ maas_image }}
    container_name: pricetag-maas
    pull_policy: missing
    networks:
      pricetag-private:
        ipv4_address: 10.77.0.10
    environment:
      MAAS_RUNTIME_MODE: standalone
      MAAS_SUBSCRIPTION_MODE: standalone
      ADDRESS: ":8080"
      SECURE: "false"
      DB_CONNECTION_URL_FILE: /run/secrets/maas-db-url
      API_KEY_MAX_EXPIRATION_DAYS: "90"
      MAAS_ADMIN_GROUPS: single-server-admin
      MAAS_TRUSTED_PROXY_CIDRS: "127.0.0.1/32,10.77.0.0/24,10.78.0.0/24"
      METRICS_SECURE: "false"
      METRICS_ADDRESS: "127.0.0.1:9090"
    volumes:
      - {{ deploy_dir | default("~/.local/share/enmaas-mini/laptop") }}/maas-db-url:/run/secrets/maas-db-url:ro
    depends_on:
      pricetag-db:
        condition: service_healthy
    ports:
      - "127.0.0.1:18086:8080"
    restart: unless-stopped
    user: "1001:1001"
    read_only: false
    cap_drop:
      - ALL
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://127.0.0.1:8080/health || wget -qO- http://127.0.0.1:8080/health || python3 -c \"import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health', timeout=2).read()\""]
      interval: 10s
      timeout: 5s
      retries: 15
      start_period: 20s

  pricetag-metering:
    image: {{ metering_image }}
    container_name: pricetag-metering
    pull_policy: missing
    networks:
      pricetag-private:
        ipv4_address: 10.77.0.12
    environment:
      DATABASE_URL: "postgres://metering:{{ metering_password }}@pricetag-db:5432/metering?sslmode=disable"
      M2M_AUTH_REQUIRED: "true"
      M2M_SHARED_SECRET: "{{ m2m_secret }}"
      SESSION_SECRET: "{{ session_secret }}"
      MANAGEMENT_API_SECRET: "{{ management_secret }}"
      MANAGEMENT_PUBLIC_ORIGIN: "https://{{ hostname }}:8443"
      WELCOME_GATEWAY_URL: "https://{{ hostname }}:8443"
      WELCOME_DASHBOARD_URL: "https://{{ hostname }}:8443"
      DEFAULT_KEY_EXPIRY_HOURS: "2160"
      MAX_KEY_EXPIRY_HOURS: "2160"
      GATEWAY_MODELS_FILE: /etc/gateway-catalog/models.json
      KEY_SERVICE_URL: "http://pricetag-maas:8080"
      KEY_SERVICE_USER_HEADER: "X-MaaS-Username"
      KEY_SERVICE_GROUPS_HEADER: "X-MaaS-Group"
      PARTNER_USER_KEY_GROUP: "system:authenticated"
      SUPERADMIN_USERS: "admin"
      MONTHLY_TOKEN_QUOTA: "10000000000"
      TZ: UTC
      MAAS_VALIDATE_URL: "http://pricetag-maas:8080/internal/v1/api-keys/validate"
    volumes:
      - {{ deploy_dir | default("~/.local/share/enmaas-mini/laptop") }}/catalog:/etc/gateway-catalog:ro
    depends_on:
      pricetag-db:
        condition: service_healthy
      pricetag-maas:
        condition: service_started
    ports:
      - "127.0.0.1:18087:8080"
    restart: unless-stopped
    user: "1001:1001"
    read_only: false
    cap_drop:
      - ALL
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://127.0.0.1:8080/ready || wget -qO- http://127.0.0.1:8080/ready || python3 -c \"import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/ready', timeout=2).read()\""]
      interval: 10s
      timeout: 5s
      retries: 15
      start_period: 30s

  pricetag-gateway:
    image: {{ praxis_image }}
    container_name: pricetag-gateway
    pull_policy: missing
    networks:
      pricetag-private:
        ipv4_address: 10.77.0.11
      pricetag-mock:
        # Gateway is the only bridge between private and mock; llm-katan is not on private otherwise.
        # This dual-homing is required so the gateway can reach pricetag-provider:8000 while
        # the mock network remains isolated from metering/maas.
        ipv4_address: 10.78.0.2
    environment:
      GATEWAY_CONFIG: /etc/praxis/gateway.json
    volumes:
      - {{ deploy_dir | default("~/.local/share/enmaas-mini/laptop") }}/gateway:/etc/praxis:ro
    secrets:
      - pricetag-m2m
      - pricetag-mock-ui-v1
    ports:
      - "0.0.0.0:8443:8443"
    depends_on:
      pricetag-maas:
        condition: service_started
      pricetag-metering:
        condition: service_started
      llm-katan:
        condition: service_healthy
    restart: unless-stopped
    user: "1001:1001"
    read_only: true
    cap_drop:
      - ALL
    healthcheck:
      test: ["CMD-SHELL", "curl -kfsS https://127.0.0.1:8443/login >/dev/null || wget --no-check-certificate -qO- https://127.0.0.1:8443/login >/dev/null || python3 -c \"import ssl,urllib.request; ctx=ssl._create_unverified_context(); urllib.request.urlopen('https://127.0.0.1:8443/login', context=ctx, timeout=2).read()\""]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 15s
    command: ["-c", "/etc/praxis/gateway.json"]

networks:
  pricetag-private:
    name: pricetag-private
    driver: bridge
    ipam:
      config:
        - subnet: 10.77.0.0/24
          gateway: 10.77.0.1
  pricetag-mock:
    name: pricetag-mock
    driver: bridge
    internal: false
    # Isolated synthetic provider network; only the gateway is dual-homed.
    # pricetag-mock hosts llm-katan; pricetag-private hosts DB/MaaS/metering.
    # Gateway bridges them (10.77.0.11 + 10.78.0.2) so metering never sees mock traffic directly.
    ipam:
      config:
        - subnet: 10.78.0.0/24
          gateway: 10.78.0.1

volumes:
  pricetag-data:
    name: pricetag-data

secrets:
  pricetag-m2m:
    file: {{ deploy_dir | default("~/.local/share/enmaas-mini/laptop") }}/m2m-secret
  pricetag-mock-ui-v1:
    # Synthetic provider credential; env target CUSTOM_MOCK_API_KEY.
    # Must match: configs/laptop/llm-katan.env CUSTOM_MOCK_API_KEY=synthetic-anthropic
    # and mock-guard expectation: Secret=pricetag-mock-ui-v1,type=env,target=CUSTOM_MOCK_API_KEY
    file: {{ deploy_dir | default("~/.local/share/enmaas-mini/laptop") }}/mock-secret
    # For compose compatibility the secret is also available as ./mock-secret bind-mount.
