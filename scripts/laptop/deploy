                    if isinstance(key, str) and key:
                        admin_key.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
                        # Secure write (0600, O_EXCL)
                        if admin_key.exists():
                            admin_key.unlink()
                        os.umask(0o077)
                        fd = os.open(str(admin_key), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
                        with os.fdopen(fd, "w") as out:
                            out.write(key + "\n")
                        print(f"  Admin key created via gateway (trusted 10.77.0.11): {admin_key}", flush=True)
                        logger.info("Admin key via gateway exec")
                        return True
                    else:
                        logger.warning("gateway exec returned no key: %s", result.stdout)
                else:
                    logger.warning("gateway exec failed: rc=%s out=%s err=%s", result.returncode, result.stdout, result.stderr)
