def ensure_postgres_volume(deploy_dir: Path | None = None, postgres_image: str | None = None) -> None:
    """Pre-create pricetag-data volume with correct ownership for postgres UID.

    Rootless podman volumes are initially owned by the host UID (1001) but
    postgres (UID 70/999) needs to chown/chmod on first init. With cap_drop
    removed, postgres can chown itself, but pre-creating ensures idempotent
    ownership and avoids 'Operation not permitted' on repeatable --from-scratch.
    """
    engine: str = "podman" if shutil.which("podman") else "docker"
    image: str = postgres_image or POSTGRES_IMAGE
    try:
        subprocess.run([engine, "volume", "create", "pricetag-data"],
                       timeout=10, stdout=LOG_FD or subprocess.DEVNULL, stderr=LOG_FD or subprocess.DEVNULL)
        logger.info("Volume pricetag-data created (or already exists)")
    except Exception as e:
        logger.warning("volume create failed: %s", e)
    # Fix ownership via one-shot container (postgres image has chown).
    # Try UID 999 (debian postgres:17.8), 70 (alpine), 26 (rhel) in order.
    for uid in ("999", "70", "26"):
        try:
            subprocess.run(
                [engine, "run", "--rm", "-v", "pricetag-data:/var/lib/postgresql/data",
                 image, "sh", "-c",
                 f"chown -R {uid}:{uid} /var/lib/postgresql/data 2>/dev/null; chmod 700 /var/lib/postgresql/data 2>/dev/null; ls -ld /var/lib/postgresql/data"],
                timeout=15, stdout=LOG_FD or subprocess.DEVNULL, stderr=LOG_FD or subprocess.DEVNULL
            )
            logger.info("Volume ownership set to %s:%s", uid, uid)
            break
        except Exception as e:
            logger.warning("volume chown attempt %s failed: %s", uid, e)
            continue
    # Ensure deploy_dir/maas-db-url is a regular file, not symlink (MaaS rejects symlinks)
    if deploy_dir:
        maas_url_path = Path(deploy_dir) / "maas-db-url"
        try:
            if maas_url_path.is_symlink():
                target = maas_url_path.readlink()
                # Resolve and replace symlink with regular file copy
                content = maas_url_path.read_text()
                maas_url_path.unlink()
                maas_url_path.write_text(content)
                os.chmod(maas_url_path, 0o600)
                print(f"  Fixed symlink {maas_url_path} -> {target} (replaced with regular file)", flush=True)
                logger.info("Fixed symlink %s -> %s", maas_url_path, target)
            elif maas_url_path.is_file():
                # Ensure perms are 0600 and is regular file
                st = maas_url_path.lstat()
                # lstat ensures we don't follow symlink; already checked is_symlink above
                pass
        except Exception as e:
            logger.warning("maas-db-url symlink check failed: %s", e)


