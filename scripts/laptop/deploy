        maas_key_script = ROOT / "scripts/pricetag/maas-key"
        # Darwin applehv: host 127.0.0.1:18086 may be untrusted (NAT), fallback to gateway exec (trusted 10.77.0.11)
        def _create_via_gateway() -> bool:
            try:
                result = subprocess.run(
                    [engine_name, "exec", "pricetag-gateway", "curl", "-s", "-X", "POST",
                     "-H", "X-MaaS-Username: admin",
