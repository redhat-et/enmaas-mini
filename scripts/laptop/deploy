def valid_hostname(value: str) -> bool:
    try:
        ipaddress.IPv4Address(value)
        return True
    except ValueError:
        pass
    try:
        ipaddress.IPv6Address(value)
        return True
    except ValueError:
        pass
    if not value or len(value) > 253:
        return False
    return all(
        re.fullmatch(r"[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?", part)
        for part in value.split(".")
    )


def oci_arch(machine: str) -> str:
    mapping: dict[str, str] = {"x86_64": "amd64", "amd64": "amd64", "aarch64": "arm64", "arm64": "arm64"}
    if machine not in mapping:
        raise ValueError(f"unsupported architecture: {machine} (expected x86_64 or aarch64/arm64)")
    return mapping[machine]


def parse_version(v: str) -> tuple[int, ...]:
    v = v.lstrip("v").split("-")[0].split("+")[0]
    parts = re.split(r"\.", v)
    out: list[int] = []
    for p in parts:
        m = re.match(r"(\d+)", p)
        if m:
            out.append(int(m.group(1)))
        else:
            break
    return tuple(out) if out else (0,)


def version_gte(have: str, need: str) -> bool:
    return parse_version(have) >= parse_version(need)


