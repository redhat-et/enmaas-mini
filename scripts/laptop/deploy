def bootstrap_via_http(deploy_dir: Path, admin_dir: Path) -> None:
    """Minimal metering bootstrap for laptop (no root required)."""
    import urllib.error
    import urllib.request

    bootstrap_path = deploy_dir / "bootstrap.json"
    if not bootstrap_path.is_file():
        raise FileNotFoundError(f"bootstrap.json missing: {bootstrap_path}")
    config = json.loads(bootstrap_path.read_text())
    management_secret: str = (deploy_dir / "management-secret").read_text().strip()
    if not management_secret:
        raise ValueError("management-secret missing")

    base: str = "http://127.0.0.1:18087/api/v1/management"
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))

    def request(method: str, resource: str, payload: Any | None = None) -> Any:
        url = f"{base}/{resource}"
        data = None if payload is None else json.dumps(payload).encode()
        req = urllib.request.Request(url, data=data, method=method,
                                     headers={"Authorization": f"Bearer {management_secret}",
                                              "Content-Type": "application/json"})
        try:
            with opener.open(req, timeout=10) as resp:
                return json.load(resp)
        except urllib.error.HTTPError as e:
            raise RuntimeError(f"metering {resource} returned HTTP {e.code}") from None

    try:
        request("PUT", "policy", {"default_monthly_usd": config["monthly_usd"], "enforced": True,
                                   "allowed_over_limit_models": []})
    except RuntimeError as e:
        print(f"  WARN: policy put failed: {e}", flush=True)
        logger.warning("policy put failed: %s", e)

    try:
        existing = request("GET", "prices") or []
        existing_models = {p["Model"] for p in existing}
        for model in config["models"]:
            billed: str = model["model"]
            source: str = config["sources"].get(model["id"], billed)
            if billed in existing_models:
                continue
            if source not in existing_models:
                print(f"  No source price for {billed}; using fallback", flush=True)
                continue
            request("PUT", "prices", {"model": billed, "provider": model["provider"], "source_model": source})
            existing_models.add(billed)
    except Exception as e:
        print(f"  WARN: price bootstrap failed: {e}", flush=True)
        logger.warning("price bootstrap failed: %s", e)

    def provision(subject: str, name: str | None, budget: float | None, admin: bool = False) -> None:
        body: dict[str, Any] = {"subject": subject}
        if name:
            body["name"] = name
        if admin:
            body["role"] = "super_admin"
        try:
            request("PUT", "users", body)
        except Exception as e:
            print(f"  WARN: provision {subject} failed: {e}", flush=True)
            logger.warning("provision %s failed: %s", subject, e)
        if budget is not None:
            try:
                request("PUT", "budgets", {"subject": subject, "monthly_usd": budget})
            except Exception as e:
                print(f"  WARN: budget for {subject} failed: {e}", flush=True)
                logger.warning("budget for %s failed: %s", subject, e)

    provision("admin", "Administrator", None, admin=True)
    monthly = config.get("monthly_usd", 5)
    if (deploy_dir / "sample-users").read_text().strip() == "yes":
        for subj in ("alice", "bob"):
            provision(subj, subj.capitalize(), monthly)


