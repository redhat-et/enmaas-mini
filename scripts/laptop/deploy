def should_delegate_to_rhel() -> bool:
    """Return True if this host is RHEL Linux and should use install.py."""
    if platform.system() != "Linux":
        return False
    os_release = Path("/etc/os-release")
    if not os_release.is_file():
        return False
    try:
        content = os_release.read_text()
        if re.search(r'^ID="?rhel"?$', content, re.M):
            return True
    except OSError:
        pass
    return False


def delegate_to_install(passthrough_args: list[str]) -> int:
    """Delegate to RHEL Quadlet installer (install.py) with same args."""
    installer: Path = ROOT / "scripts/pricetag/install.py"
    if not installer.is_file():
        print(f"error: RHEL installer not found at {installer}", file=sys.stderr)
        return 1
    print("Detected RHEL host; delegating to scripts/pricetag/install.py (Quadlet path)", flush=True)
    print(f"  Delegating: {sys.executable} {installer} {shlex.join(passthrough_args)}", flush=True)
    result = subprocess.run([sys.executable, str(installer), *passthrough_args])
    return result.returncode


