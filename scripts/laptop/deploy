    # Primary flags required by spec (canonical):
    p.add_argument("--llm-katan", choices=("mock", "fixture", "vllm", "external", "echo"),
                   default=None,
                   help="llm-katan backend choice: mock/fixture (deterministic), echo, vllm or external (default: mock)")
    p.add_argument("--with-llm-katan", action="store_true",
                   help="enable llm-katan sidecar (alias for --llm-katan mock; use --llm-katan for backend choice)")
    p.add_argument("--llm-katan-backend", choices=("echo", "mock", "fixture", "vllm", "external"),
                   default=None,
                   help="llm-katan backend alias (prefer --llm-katan; default: mock)")
    p.add_argument("--deploy-dir", type=Path, default=DEFAULT_DEPLOY_DIR,
                   help=f"laptop deploy directory (default: {DEFAULT_DEPLOY_DIR})")
    p.add_argument("--admin-dir", type=Path, default=DEFAULT_ADMIN_DIR,
                   help=f"admin credentials directory (default: {DEFAULT_ADMIN_DIR})")
    p.add_argument("--compose-file", type=Path, default=DEFAULT_COMPOSE_FILE,
                   help=f"compose file to generate (default: {DEFAULT_COMPOSE_FILE})")
    p.add_argument("--no-pull", action="store_true", help="skip image pulls (use local images)")

    args = p.parse_args(argv)

    # Back-compat: --llm-katan maps to --with-llm-katan + --llm-katan-backend
    if args.llm_katan is not None:
        args.with_llm_katan = True
        # echo is explicit; mock/fixture map to mock backend
        if args.llm_katan == "echo":
            args.llm_katan_backend = "echo"
        else:
            args.llm_katan_backend = args.llm_katan

    # Default: no llm-katan (use deterministic fixture provider for benchmark)
    # llm-katan is opt-in via --with-llm-katan / --llm-katan echo to keep
    # the default path private-registry-free and token-deterministic (2+3=5).
    if args.llm_katan is None and args.llm_katan_backend is None:
        args.llm_katan = None
        args.llm_katan_backend = None
        args.with_llm_katan = False

    # Normalize: if --with-llm-katan not set but backend is echo, imply with
    if args.llm_katan_backend == "echo":
        args.with_llm_katan = True

    if args.hostname and not valid_hostname(args.hostname):
        p.error(f"provide --hostname with a valid IPv4/IPv6 or DNS name, got: {args.hostname!r}")
    if not 1 <= args.monthly_usd <= 10000:
        p.error("--monthly-usd must be 1-10000")
    if args.demo_fixture and args.mode != "mock":
        p.error("--demo-fixture requires --mode mock")
    if args.mode == "mock" and args.provider:
        p.error("mock mode cannot configure real providers")
    if args.mode == "real" and not args.provider:
        if not args.plan:
            p.error("real mode requires --provider openai and/or --provider external")
    if "external" in args.provider and not args.external_api:
        if args.plan:
            args.external_api = "both"
        else:
            p.error("--provider external requires --external-api openai|anthropic|both")
    # Image defaults: prefer published hardened images on all platforms;
    # the yossiovadia private image is only used if explicitly passed via --maas-image
    if not args.maas_image:
        args.maas_image = PUBLISHED_MAAS_IMAGE
        if platform.system() == "Darwin" and oci_arch(platform.machine()) == "arm64" and LOG_FD:
            LOG_FD.write(f"Using published MaaS image on MBP arm64 (manifest list, Rosetta fallback OK): {args.maas_image}\n")
    if not args.metering_image:
        args.metering_image = PUBLISHED_METERING_IMAGE

    if args.image_mode == "published":
        for field in ("maas_image", "metering_image"):
            image = getattr(args, field)
            if not image:
                continue
            if not (re.fullmatch(r"[a-z0-9][a-z0-9.:-]*/[a-z0-9_./-]+@sha256:[0-9a-f]{64}", image)
                    or re.fullmatch(r"[a-z0-9][a-z0-9.:_-]*/[a-z0-9._/-]+:[a-zA-Z0-9._/-]+", image)
                    or re.fullmatch(r"[a-z0-9][a-z0-9.:_-]*/[a-z0-9_./:-]+", image)):
                if "@" in image or "/" in image:
                    pass
                else:
                    p.error(f"--{field.replace('_','-')} must be a valid image reference: {image}")

    args.provider = list(dict.fromkeys(args.provider))
    return args


