def verify_deployment(args: argparse.Namespace, state: dict[str, Any]) -> None:
    """Run harness + benchmark 20 requests, check exact ledger."""
    print("\n[Verify] Running harness + benchmark (20 requests) ...", flush=True)
    logger.info("Verify: harness + benchmark 20 requests")
    deploy_dir: Path = state["deploy_dir"]
    admin_dir: Path = state["admin_dir"]
    ca_pem: Path = deploy_dir / "ca.pem"

    try:
        run(["curl", "--noproxy", "*", "--fail", "--silent", "--show-error",
             "--cacert", str(ca_pem), "https://localhost:8443/login", "--output", "/dev/null"],
            label="Verifying gateway HTTPS")
    except Exception:
        try:
            run(["curl", "-k", "--fail", "--silent", "https://localhost:8443/login", "--output", "/dev/null"],
                label="Verifying gateway HTTPS (insecure fallback)")
        except Exception as e:
            print(f"  WARN: gateway health check failed: {e}", flush=True)
            logger.warning("gateway health check failed: %s", e)

    admin_key = admin_dir / "admin.key"
    if not admin_key.is_file():
        print(f"  WARN: admin key missing {admin_key}, skipping benchmark", flush=True)
        logger.warning("admin key missing %s", admin_key)
        return

    tmp_dir = Path(tempfile.mkdtemp(prefix="praxis-verify-", dir="/tmp"))
    os.chmod(tmp_dir, 0o700)
    try:
        perf = ROOT / "scripts/pricetag/perf"
        tokens_dir = tmp_dir / "keys"
        report_path = tmp_dir / "requests.json"
        try:
            run(
                [sys.executable, str(perf), "users", "--tokens", str(tokens_dir),
                 "--prefix", "perf-verify", "--count", "1", "--maas-url", "http://127.0.0.1:18086",
                 "--monthly-usd", "100"],
                label="Creating verify user (perf-verify-00)"
            )
        except subprocess.CalledProcessError as e:
            print(f"  WARN: perf users creation failed: {e}", flush=True)
            logger.warning("perf users creation failed: %s", e)
            return

        model: str = state["models"][0]["id"] if state.get("models") else "fixture"
        print(f"  Running perf run: model={model} url=https://localhost:8443 requests=20 ...", flush=True)
        try:
            run(
                [sys.executable, str(perf), "run",
                 "--model", model, "--url", "https://localhost:8443",
                 "--ca", str(ca_pem), "--tokens", str(tokens_dir),
                 "--concurrency", "1", "--requests", "20", "--think", "0",
                 "--output", str(report_path)],
                label="Running 20-request benchmark"
            )
            report = json.loads(report_path.read_text())
            successes = sum(p.get("successes", 0) for p in report.get("phases", []))
            print(f"  Benchmark: {successes}/20 succeeded", flush=True)
            logger.info("Benchmark: %d/20 succeeded", successes)
            if successes < 20:
                print(f"  WARN: benchmark had {20 - successes} failures, inspecting report...", flush=True)
                if LOG_FD:
                    LOG_FD.write(report_path.read_text())
        except subprocess.CalledProcessError as e:
            print(f"  WARN: perf run failed: {e}", flush=True)
            logger.warning("perf run failed: %s", e)
            return

        # Deterministic tokens: llm-katan echo uses word-count (variable), not 2+3=5.
        # perf verify expects exact 2*count + 3*count, which fails under llm-katan.
        # Strategy: when backend is llm-katan echo, verify counts are exact but allow
        # variable token totals (positive, consistent: total == prompt+completion).
        is_llm_katan_verify = getattr(args, "llm_katan_backend", "echo") == "echo" or os.environ.get("PERF_VERIFY_MODE") == "llm-katan"
        if is_llm_katan_verify:
            print("  Ledger verification: llm-katan mode (variable tokens, exact event counts)", flush=True)
            try:
                report = json.loads(report_path.read_text())
                expected_counts = {}
                for phase in report.get("phases", []):
                    for sample in phase.get("samples", []):
                        if sample.get("ok"):
                            subj = sample.get("subject", "")
                            expected_counts[subj] = expected_counts.get(subj, 0) + 1
                if not expected_counts:
                    print("  Ledger verification: no successful requests to verify", flush=True)
                else:
                    engine = "podman" if shutil.which("podman") else "docker"
                    query = "SELECT username,count(*),sum(prompt_tokens),sum(completion_tokens),sum(total_tokens) FROM usage_events WHERE username IN (" + ",".join("'" + s + "'" for s in expected_counts) + ") GROUP BY username;"
                    raw = subprocess.check_output(
                        [engine, "exec", "pricetag-db", "psql", "-U", "metering", "-d", "metering", "-At", "-c", query],
                        text=True, timeout=10, cwd="/tmp",
                    )
                    actual = {}
                    for line in raw.splitlines():
                        if not line.strip():
                            continue
                        parts = line.split("|")
                        actual[parts[0]] = [int(parts[1]), int(parts[2] or 0), int(parts[3] or 0), int(parts[4] or 0)]
                    ok = True
                    for subj, count in expected_counts.items():
                        if subj not in actual:
                            print(f"  FAIL: missing ledger rows for {subj} (expected {count} events)", flush=True)
                            ok = False
                            continue
                        got = actual[subj]
                        if got[0] != count:
                            print(f"  FAIL: {subj} count {got[0]} != expected {count}", flush=True)
                            ok = False
                        # Variable tokens: just check positive and consistent
                        if got[1] <= 0 or got[2] <= 0 or got[3] <= 0:
                            print(f"  FAIL: {subj} non-positive tokens {got[1:]}", flush=True)
                            ok = False
                        if got[1] + got[2] != got[3]:
                            print(f"  FAIL: {subj} total {got[3]} != prompt {got[1]} + completion {got[2]}", flush=True)
                            ok = False
                    if ok:
                        print(f"  Ledger verification: PASS (llm-katan mode: {sum(expected_counts.values())} events, variable tokens consistent)", flush=True)
                        logger.info("Ledger verification PASS (llm-katan variable tokens)")
                    else:
                        print(f"  Ledger verification: FAIL: expected={expected_counts} actual={actual}", flush=True)
                        logger.warning("Ledger verification FAIL (llm-katan): expected=%s actual=%s", expected_counts, actual)
            except Exception as e:
                print(f"  WARN: llm-katan ledger verify failed: {e}", flush=True)
                logger.warning("llm-katan ledger verify failed: %s", e)
        else:
            try:
                engine: str = "podman" if shutil.which("podman") else "docker"
                verify_args: list[str] = [
                    sys.executable, str(perf), "verify",
                    "--report", str(report_path),
                    "--database", "pricetag-db", "--database-name", "metering",
                ]
                proc = subprocess.run(verify_args, capture_output=True, text=True, timeout=30, cwd="/tmp")
                if proc.returncode == 0:
                    print("  Ledger verification: PASS (exact per-user event/token totals)", flush=True)
                    logger.info("Ledger verification PASS")
                else:
                    print(f"  Ledger verification: FAIL: {proc.stdout} {proc.stderr}", flush=True)
                    logger.warning("Ledger verification FAIL: %s %s", proc.stdout, proc.stderr)
                    query: str = "SELECT username,count(*),sum(prompt_tokens) FROM usage_events WHERE username LIKE 'perf-%' GROUP BY username;"
                    try:
                        q = subprocess.run(
                            [engine, "exec", "pricetag-db", "psql", "-U", "metering", "-d", "metering", "-At", "-c", query],
                            capture_output=True, text=True, timeout=10
                        )
                        print(f"  Direct DB query: {q.stdout.strip() or '(empty)'}", flush=True)
                    except Exception as e:
                        print(f"  Direct DB check failed: {e}", flush=True)
            except Exception as e:
                print(f"  WARN: ledger verify failed: {e}", flush=True)
                logger.warning("ledger verify failed: %s", e)

    finally:
        print(f"  Verify artifacts: {tmp_dir}", flush=True)
        if not args.from_scratch:
            print(f"  To clean verify users: python3 {ROOT}/scripts/pricetag/perf verify ... ; rm -rf {tmp_dir}", flush=True)

    print("  Verify complete", flush=True)


