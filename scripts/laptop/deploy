def verify_image_arch(image: str, expected_arch: str) -> None:
    """Check image arch matches host; warn but don't fail on laptop (multi-arch)."""
    engine: str = "podman" if shutil.which("podman") else "docker"
    try:
        arch = subprocess.run(
            [engine, "image", "inspect", image, "--format", "{{.Architecture}}"],
            capture_output=True, text=True, timeout=10
        )
        if arch.returncode == 0 and arch.stdout.strip():
            actual: str = arch.stdout.strip()
            if actual != expected_arch:
                print(f"  WARN: image {image} arch {actual} != host {expected_arch} (may be manifest list; continuing)", flush=True)
                logger.warning("Image %s arch %s != host %s", image, actual, expected_arch)
            else:
                print(f"  Image arch OK: {image} -> {actual}", flush=True)
                logger.info("Image arch OK: %s -> %s", image, actual)
    except Exception as e:
        print(f"  WARN: could not verify image arch for {image}: {e}", flush=True)
        logger.warning("Could not verify image arch for %s: %s", image, e)


def acquire_images(args: argparse.Namespace, arch: str) -> tuple[str, ...]:
    """Stage 3: Acquire application images (platform-aware amd64/arm64)."""
    stage(3, "Acquire application images")
    if args.image_mode == "source":
        print("  Resolving source refs and building; this can take several minutes.", flush=True)
        logger.info("Resolving source refs and building")
        cache = Path("/var/cache/pricetag-installer") if platform.system() == "Linux" else Path.home() / ".cache/pricetag-installer"
        cache.mkdir(mode=0o700, parents=True, exist_ok=True)

        def checkout(repository: str, directory: Path, revision: str | None) -> None:
            if directory.exists():
                if directory.is_symlink() or not (directory / ".git").is_dir():
                    raise RuntimeError("invalid source cache: " + str(directory))
                if run(["git", "-C", str(directory), "remote", "get-url", "origin"], capture=True) != repository:
                    raise RuntimeError("source cache has an unexpected origin")
                if run(["git", "-C", str(directory), "status", "--porcelain"], capture=True):
                    raise RuntimeError("source cache is dirty; review it before retrying")
            else:
                run(["git", "clone", repository, str(directory)])
            if revision:
                run(["git", "-C", str(directory), "fetch", "origin", revision])
                run(["git", "-C", str(directory), "checkout", "--detach", "FETCH_HEAD"])

        maas_repo = "https://github.com/Ladas/models-as-a-service.git"
        metering_repo = "https://github.com/Ladas/pricetag-metering.git"
        for component, repo in (("maas", maas_repo), ("metering", metering_repo)):
            branch = getattr(args, component + "_branch")
            rev = getattr(args, component + "_revision")
            checkout(repo, cache / component, "refs/heads/" + branch if branch else rev)
            if branch:
                rev = run(["git", "-C", str(cache / component), "rev-parse", "HEAD"], capture=True)
                if not re.fullmatch(r"[0-9a-f]{40}", rev or ""):
                    raise ValueError("Source branch did not resolve to a full commit")
                setattr(args, component + "_revision", rev)
            print(f"  {component}: {branch or 'commit'} -> {rev}", flush=True)
        run([str(ROOT / "scripts/pricetag/build-maas"), "--source", str(cache / "maas"),
             "--expected-commit", args.maas_revision, "--platform", "linux/" + arch], label="Building MaaS")
        run([sys.executable, str(ROOT / "scripts/pricetag/build-metering"), "--source", str(cache / "metering"),
             "--revision", args.metering_revision, "--platform", "linux/" + arch], label="Building PriceTag")
        images: tuple[str, ...] = ("localhost/pricetag-maas:standalone", "localhost/pricetag-metering:upstream-b1c5ce0")
        for image in images:
            verify_image_arch(image, arch)
        return images

    # Published (pull)
    engine: str = "podman" if shutil.which("podman") else "docker"
    # llm-katan image: ghcr.io for echo backend, else PYTHON fallback
    # Only pull llm-katan if explicitly enabled; otherwise use fixture (PYTHON_IMAGE)
    if args.with_llm_katan and args.llm_katan_backend in ("echo", "mock", "fixture"):
        provider_image = LLM_KATAN_IMAGE
        images_list: list[tuple[str, str]] = [
            ("Praxis", PRAXIS_IMAGE),
            ("MaaS", args.maas_image),
            ("PriceTag metering", args.metering_image),
            ("Postgres 17.8", POSTGRES_IMAGE),
            ("LLM-Katan", provider_image),
        ]
    else:
        images_list: list[tuple[str, str]] = [
            ("Praxis", PRAXIS_IMAGE),
            ("MaaS", args.maas_image),
            ("PriceTag metering", args.metering_image),
            ("Postgres 17.8", POSTGRES_IMAGE),
        ]
    if args.no_pull:
        print("  --no-pull: skipping pulls, using local images", flush=True)
        logger.info("--no-pull: skipping pulls")
        return (args.maas_image, args.metering_image)
    for name, image in images_list:
        if not image:
            continue
        print(f"  {name} image: {image}", flush=True)
        logger.info("%s image: %s (platform linux/%s)", name, image, arch)
        try:
            # Platform-aware pull: include --platform when possible
            pull_cmd: list[str] = [engine, "pull"]
            # Podman supports --platform; docker too with buildx
            # Only add platform for arch-sensitive images (not postgres meta)
            if arch and name in ("MaaS", "PriceTag metering", "Praxis", "LLM-Katan"):
                pull_cmd += ["--platform", f"linux/{arch}"]
            pull_cmd.append(image)
            run(pull_cmd, label=f"Pulling {name}")
        except subprocess.CalledProcessError as e:
            if "MaaS" in name and "yossiovadia" in image:
                print(f"  WARN: MaaS laptop image pull failed: {e}. Build arm64 locally:", flush=True)
                print(f"    git clone https://github.com/yossiovadia/models-as-a-service --branch feat/standalone-api-key-mode", flush=True)
                print(f"    podman build --platform linux/{arch} -t {image} -f maas-api/Dockerfile maas-api", flush=True)
                print("  Continuing with local image if present...", flush=True)
                logger.warning("MaaS laptop image pull failed: %s", e)
                continue
            if "LLM-Katan" in name:
                print(f"  WARN: LLM-Katan pull failed (private registry or no auth): {e}", flush=True)
                print(f"    ghcr.io/yossiovadia/llm-katan:0.22.0 is private; falling back to fixture provider", flush=True)
                print(f"    (tests/common/provider.py on {PYTHON_IMAGE}) — deterministic 2+3=5 tokens", flush=True)
                print(f"    To use llm-katan, build locally: git clone https://github.com/yossiovadia/llm-katan && podman build -t {image} -f Containerfile .", flush=True)
                logger.warning("LLM-Katan pull failed, falling back to fixture: %s", e)
                # Mark as fallback so later stages use fixture provider (no image needed)
                args.llm_katan_backend = "fixture"
                args.with_llm_katan = False
                continue
            raise
        verify_image_arch(image, arch)
    return (args.maas_image, args.metering_image)


def import_images(args: argparse.Namespace, arch: str, images: tuple[str, ...]) -> tuple[str, ...]:
    """Stage 4: Import images (RHEL imports into service account; Darwin verifies local store).

    For laptop Darwin, 'import' means verifying images are present locally
    and (if using podman machine) available inside the VM. No cross-store
    transfer is needed, but we validate digests/revision where possible.
    """
    stage(4, "Import images")
    if should_delegate_to_rhel():
        # On RHEL, this would import into praxis-svc store (delegated path never reaches here)
        print("  RHEL path: would import into praxis-svc store (delegated)", flush=True)
        return images
    engine: str = "podman" if shutil.which("podman") else "docker"
    ids: list[str] = []
    for image in (PRAXIS_IMAGE, *images):
        if not image:
            continue
        try:
            # Check presence via inspect; if missing, error
            img_id = run([engine, "image", "inspect", image, "--format", "{{.Id}}"], capture=True)
            if not img_id:
                raise RuntimeError(f"image not found after pull: {image}")
            print(f"  OK: {image} -> {img_id[:12]}...", flush=True)
            logger.info("OK: %s -> %s", image, img_id)
            ids.append(img_id)
        except subprocess.CalledProcessError:
            print(f"  WARN: image not in local store: {image} (will pull on compose up)", flush=True)
            logger.warning("Image not in local store: %s", image)
            ids.append(image)
    # For Darwin, also verify architecture of imported images
    for img in images:
        verify_image_arch(img, arch)
    return tuple(ids) if ids else images


