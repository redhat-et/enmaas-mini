logger: logging.Logger = logging.getLogger("deploy")


def stage(number: int | str, title: str) -> None:
    global STAGE
    STAGE = title
    msg = f"\n[{number}/6] {title}\n" + "-" * 54
    print(msg, flush=True)
    logger.info(msg)
    if LOG_FD:
        LOG_FD.write(msg + "\n")
        LOG_FD.flush()


def open_log(directory: str = "/tmp") -> Path:
    global LOG_FD, LOG_PATH
    Path(directory).mkdir(parents=True, exist_ok=True)
    fd, name = tempfile.mkstemp(prefix="praxis-laptop-deploy-", suffix=".log", dir=directory)
    LOG_PATH = Path(name)
    os.chmod(LOG_PATH, 0o600)
    LOG_FD = os.fdopen(fd, "w", buffering=1)
    handler = logging.FileHandler(str(LOG_PATH))
    handler.setFormatter(logging.Formatter("%(asctime)s %(levelname)s %(message)s"))
    logger.addHandler(handler)
    logger.setLevel(logging.DEBUG)
    print(f"\nDetailed log: {LOG_PATH} (private)\nFollow: tail -f {LOG_PATH}", flush=True)
    logger.info("Detailed log: %s", LOG_PATH)
    return LOG_PATH


def log_cmd(cmd: list[str]) -> None:
    if LOG_FD:
        LOG_FD.write("+ " + shlex.join(cmd) + "\n")
        LOG_FD.flush()
    logger.debug("+ %s", shlex.join(cmd))


def wait_for(proc: subprocess.Popen[Any], label: str = "Working") -> int:
    started = time.monotonic()
    while True:
        try:
            return proc.wait(timeout=15)
        except subprocess.TimeoutExpired:
            elapsed = int(time.monotonic() - started)
            print(f"  {label}... {elapsed}s elapsed", flush=True)
            if LOG_FD:
                LOG_FD.write(f"  {label}... {elapsed}s elapsed\n")
                LOG_FD.flush()
            logger.debug("%s... %ds elapsed", label, elapsed)


def run(
    cmd: list[str | Path],
    capture: bool = False,
    label: str | None = None,
    cwd: str | Path = "/tmp",
    env: dict[str, str] | None = None,
    check: bool = True,
    input_data: bytes | None = None,
) -> str | None:
    cmd_str: list[str] = [str(c) for c in cmd]
    log_cmd(cmd_str)
    if LOG_FD and not capture:
        print(f"  {label or ('Running ' + Path(cmd_str[0]).name)}...", flush=True)
        logger.info("Running: %s", shlex.join(cmd_str))
        proc = subprocess.Popen(
            cmd_str,
            cwd=str(cwd),
            text=False,
            stdout=LOG_FD,
            stderr=LOG_FD,
            stdin=subprocess.PIPE if input_data is not None else None,
            env=env,
        )
        if input_data is not None and proc.stdin is not None:
            proc.stdin.write(input_data)
            proc.stdin.close()
        code = wait_for(proc, label or "Running")
        if code != 0:
            if check:
                logger.error("Command failed (%d): %s", code, shlex.join(cmd_str))
                raise subprocess.CalledProcessError(code, cmd_str)
            return None
        print("  OK", flush=True)
        logger.info("OK: %s", shlex.join(cmd_str))
        return None
    if capture:
        result = subprocess.run(
            cmd_str,
            check=check,
            cwd=str(cwd),
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            input=input_data.decode() if isinstance(input_data, bytes) else input_data,
            env=env,
        )
        return result.stdout.strip() if result.stdout else None
    result = subprocess.run(
        cmd_str,
        check=check,
        cwd=str(cwd),
        text=True,
        stdout=None,
        stderr=LOG_FD if LOG_FD else None,
        input=input_data.decode() if isinstance(input_data, bytes) else input_data,
        env=env,
    )
    return None


