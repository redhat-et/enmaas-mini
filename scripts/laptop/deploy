def check_podman() -> str:
    """Validate podman >=4.6 is available. Returns version string."""
    try:
        ver = subprocess.run(
            ["podman", "version", "--format", "{{.Client.Version}}"],
            capture_output=True, text=True, timeout=10
        )
        if ver.returncode == 0 and ver.stdout.strip():
            version = ver.stdout.strip()
            if not version_gte(version, "4.6"):
                raise ValueError(f"podman 4.6 or newer is required; found {version}")
            print(f"  Podman: {version} OK", flush=True)
            logger.info("Podman: %s OK", version)
            return version
    except FileNotFoundError:
        pass

    # Fallback: docker is acceptable for laptop (with warning)
    try:
        ver = subprocess.run(
            ["docker", "version", "--format", "{{.Client.Version}}"],
            capture_output=True, text=True, timeout=10
        )
        if ver.returncode == 0 and ver.stdout.strip():
            version = ver.stdout.strip()
            print(f"  Podman not found; using Docker {version} (laptop fallback)", flush=True)
            if LOG_FD:
                LOG_FD.write(f"  Podman not found; using Docker {version}\n")
            logger.warning("Podman not found; using Docker %s", version)
            return version
    except FileNotFoundError:
        pass

    raise ValueError("podman >=4.6 is required (or docker as fallback); not found in PATH")


def detect_compose() -> list[str]:
    """Detect compose engine: prefer podman-compose, then podman compose, then docker compose."""
    if shutil.which("podman-compose"):
        print("  Compose: podman-compose OK", flush=True)
        logger.info("Compose: podman-compose OK")
        return ["podman-compose"]
    try:
        r = subprocess.run(["podman", "compose", "version"], capture_output=True, text=True, timeout=10)
        if r.returncode == 0:
            print(f"  Compose: podman compose {r.stdout.strip()} OK", flush=True)
            logger.info("Compose: podman compose %s OK", r.stdout.strip())
            return ["podman", "compose"]
    except FileNotFoundError:
        pass
    try:
        r = subprocess.run(["docker", "compose", "version"], capture_output=True, text=True, timeout=10)
        if r.returncode == 0:
            print(f"  Compose: {r.stdout.strip()} OK", flush=True)
            logger.info("Compose: %s OK", r.stdout.strip())
            return ["docker", "compose"]
    except FileNotFoundError:
        pass
    if shutil.which("docker-compose"):
        print("  Compose: docker-compose (legacy) OK", flush=True)
        return ["docker-compose"]

    raise ValueError(
        "compose not found: install podman-compose, or enable podman/docker compose plugin. "
        "On MBP: brew install podman-compose  or  podman machine init --cpus 10 --memory 16384 --disk-size 93"
    )


def check_arch() -> str:
    machine: str = platform.machine()
    if machine not in ("x86_64", "aarch64", "arm64", "amd64"):
        raise ValueError(f"unsupported architecture: {machine} (expected x86_64 or aarch64)")
    arch: str = oci_arch(machine)
    print(f"  Host arch: {machine} -> {arch} OK", flush=True)
    logger.info("Host arch: %s -> %s OK", machine, arch)
    return arch


def check_disk_free(path: Path | str = "/tmp", required_pct: float = 30.0) -> None:
    """Require healthy disk free space on the given path.

    On MBP (Darwin) the host root is 87% used by design (125 GiB free of 926 GiB
    still shows 13% free) so a pure percent check would block valid laptops.
    Allow either >=required_pct% free OR >=20 GiB absolute free — the latter
    is the real production gate (ledger + images + WAL). VM disk is checked
    separately via podman machine inspect if needed.
    """
    try:
        usage = shutil.disk_usage(str(path))
        pct_free = (usage.free / usage.total) * 100 if usage.total else 0
        free_gib = usage.free / (1024**3)
        total_gib = usage.total / (1024**3)
        pct_used = 100 - pct_free
        print(f"  Disk {path}: {pct_free:.1f}% free ({free_gib:.1f} GiB free / {total_gib:.1f} GiB total)", flush=True)
        logger.info("Disk %s: %.1f%% free (%s GiB free)", path, pct_free, f"{free_gib:.1f}")
        # Darwin MBP exception: absolute free matters more than percent (host is 926 GiB with Time Machine snapshots)
        min_free_gib = 20.0 if platform.system() == "Darwin" else 10.0
        if pct_free < required_pct and free_gib < min_free_gib:
            raise ValueError(
                f"disk {path} has only {pct_free:.1f}% free ({free_gib:.1f} GiB) "
                f"(need >= {required_pct:.0f}% or >= {min_free_gib:.0f} GiB). "
                "Free space or prune: podman system prune -a --volumes"
            )
        if pct_free < required_pct and free_gib >= min_free_gib and platform.system() == "Darwin":
            print(f"  WARN: disk percent low but {free_gib:.1f} GiB free >= {min_free_gib:.0f} GiB — OK for MBP laptop", flush=True)
    except FileNotFoundError:
        logger.warning("Could not check disk usage for %s", path)


def check_podman_machine_resources() -> None:
    """Warn if podman machine has <10 CPU / 16 GiB / 93 GiB (MBP applehv spec for M4 Pro 14c 48 GiB host)."""
    if platform.system() != "Darwin":
        return
    try:
        result = subprocess.run(
            ["podman", "machine", "list", "--format", "json"],
            capture_output=True, text=True, timeout=10
        )
        if result.returncode == 0 and result.stdout.strip():
            machines = json.loads(result.stdout)
            if not machines:
                print("  WARN: no podman machine found; create one: podman machine init --cpus 10 --memory 16384 --disk-size 93 applehv", flush=True)
                logger.warning("No podman machine found")
                return
            for m in machines:
                cpus = m.get("CPUs") or m.get("cpus") or m.get("CPUCount") or 0
                mem = m.get("Memory") or m.get("memory") or 0
                if isinstance(mem, str):
                    mem_str = mem.lower()
                    if "gib" in mem_str:
                        mem_gib = float(mem_str.replace("gib", "").strip())
                    elif "mib" in mem_str:
                        mem_gib = float(mem_str.replace("mib", "").strip()) / 1024
                    else:
                        mem_gib = 0
                elif isinstance(mem, int):
                    mem_gib = mem / (1024**3) if mem > 1024**3 else mem / 1024
                else:
                    mem_gib = 0

                name: str = m.get("Name", "applehv")
                if isinstance(cpus, int) and cpus and cpus < 10:
                    print(f"  WARN: podman machine '{name}' has {cpus} vCPU < 10 recommended; expect degraded perf. Recreate: podman machine rm {name} && podman machine init --cpus 10 --memory 16384 --disk-size 93 {name}", flush=True)
                    logger.warning("podman machine %s has %d vCPU < 10", name, cpus)
                if mem_gib and mem_gib < 15:
                    print(f"  WARN: podman machine '{name}' has {mem_gib:.1f} GiB < 16 GiB recommended", flush=True)
                    logger.warning("podman machine %s has %.1f GiB < 16 GiB", name, mem_gib)

                try:
                    insp = subprocess.run(
                        ["podman", "machine", "inspect", name],
                        capture_output=True, text=True, timeout=10
                    )
                    if insp.returncode == 0 and insp.stdout.strip():
                        data = json.loads(insp.stdout)
                        entry = data[0] if isinstance(data, list) and data else data
                        if isinstance(entry, dict):
                            disk = entry.get("Resources", {}).get("DiskSize") or entry.get("DiskSize") or ""
                            if isinstance(disk, str) and disk:
                                if "gib" in disk.lower():
                                    disk_gib = float(disk.lower().replace("gib", "").strip())
                                    if disk_gib < 90:
                                        print(f"  WARN: podman machine '{name}' disk {disk} < 93 GiB recommended", flush=True)
                                        logger.warning("podman machine %s disk %s < 93GiB", name, disk)
                except Exception:
                    pass
                return
    except FileNotFoundError:
        pass
    except Exception as e:
        print(f"  WARN: could not inspect podman machine resources: {e}", flush=True)
        logger.warning("Could not inspect podman machine: %s", e)

    try:
        result = subprocess.run(
            ["podman", "info", "--format", "{{.Host.Cpus}} {{.Host.MemTotal}}"],
            capture_output=True, text=True, timeout=10
        )
        if result.returncode == 0 and result.stdout.strip():
            parts = result.stdout.strip().split()
            if parts:
                try:
                    cpus = int(parts[0])
                    if cpus < 10:
                        print(f"  WARN: host reports {cpus} vCPU < 10 recommended (applehv: 10 vCPU/16GiB/93GiB Fedora 41 VM)", flush=True)
                        logger.warning("Host reports %d vCPU < 10", cpus)
                except ValueError:
                    pass
    except FileNotFoundError:
        pass


