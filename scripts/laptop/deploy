def prepare_deployment(args: argparse.Namespace, arch: str) -> dict[str, Any]:
    """Stage 5: Configure providers, TLS and budgets. Create deploy_dir layout."""
    stage(5, "Configure providers, TLS and budgets")

    deploy_dir: Path = args.deploy_dir.resolve()
    admin_dir: Path = args.admin_dir.resolve()
    compose_path: Path = args.compose_file.resolve() if args.compose_file.is_absolute() else (ROOT / args.compose_file)

    deploy_dir.parent.mkdir(parents=True, exist_ok=True)
    admin_dir.parent.mkdir(parents=True, exist_ok=True)

    # Idempotency: refuse if DEPLOY exists unless --from-scratch with teardown
    if deploy_dir.exists() and not args.from_scratch:
        raise ValueError(
            f"{deploy_dir} already exists; this is a fresh installer, not an upgrade. "
            f"Use --from-scratch to teardown (compose down -v, prune volumes) and reinstall, "
            f"or run scripts/laptop/teardown --purge-volumes"
        )
    if admin_dir.exists() and not args.from_scratch and any(admin_dir.iterdir()):
        print(f"  WARN: {admin_dir} already exists; reusing (use --from-scratch to reset)", flush=True)
        logger.warning("%s already exists; reusing", admin_dir)

    if args.from_scratch and deploy_dir.exists():
        print(f"  --from-scratch: removing existing {deploy_dir}", flush=True)
        logger.info("--from-scratch: removing %s", deploy_dir)
        shutil.rmtree(deploy_dir, ignore_errors=True)

    deploy_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
    admin_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(deploy_dir, 0o700)
    os.chmod(admin_dir, 0o700)

    bundle = deploy_dir / "gateway"
    bundle.mkdir(mode=0o750, exist_ok=True)
    catalog_dir = deploy_dir / "catalog"
    catalog_dir.mkdir(mode=0o750, exist_ok=True)
    initdb = deploy_dir / "initdb"
    initdb.mkdir(mode=0o750, exist_ok=True)
    fixtures = deploy_dir / "fixtures"
    fixtures.mkdir(mode=0o750, exist_ok=True)

    sys.path.insert(0, str(ROOT / "scripts/pricetag"))
    sys.path.insert(0, str(ROOT / "scripts/common"))

    if args.mode == "mock":
        managed: bool = bool(args.demo_fixture)
        original, models = mock_inputs(managed=managed)
        if args.demo_fixture:
            print("  Mock mode: demo-fixture with two aliases (fixture, demo-cheap)", flush=True)
        else:
            print(f"  Mock mode: {len(models)} model(s)", flush=True)
        logger.info("Mock mode: %d model(s) demo_fixture=%s", len(models), args.demo_fixture)
        price_sources_path = ROOT / "configs/pricetag/perf-price-sources.json"
        if price_sources_path.is_file():
            sources: dict[str, str] = json.loads(price_sources_path.read_text())
        else:
            sources = {m["id"]: m.get("model", m["id"]) for m in models}
            if managed:
                sources = {m["id"]: "gpt-5.4-mini" for m in models}
    else:
        raise ValueError(
            "Real provider mode on laptop requires external provider setup. "
            "On MBP, use --mode mock (default) for local benchmark. "
            "For real providers, configure via scripts/pricetag/providers on RHEL, or set "
            "--provider openai --openai-key-file + --external-* flags and run with --yes."
        )

    from unified_config import validate  # type: ignore[import]
    models = validate(models)

    # llm-katan echo runs both providers on :8000 (single port, path-routed).
    # The legacy fixture separates them on :18080/:18081. Rewrite for llm-katan.
    llm_katan_backend_flag = getattr(args, "llm_katan_backend", "echo")
    if llm_katan_backend_flag == "echo":
        for chain in original.get("filter_chains", []):
            for f in chain.get("filters", []):
                if f.get("filter") == "load_balancer":
                    for cluster in f.get("clusters", []):
                        cluster["endpoints"] = ["pricetag-provider:8000"]

    from gateway import render  # type: ignore[import]
    gateway_config = render(original, models, [f"https://{args.hostname}:8443", "https://localhost:8443"])

    if not gateway_config.get("filter_chains"):
        raise ValueError("gateway render produced no filter chains")

    tls_dir = admin_dir / "tls"
    if tls_dir.exists() and args.from_scratch:
        shutil.rmtree(tls_dir, ignore_errors=True)
    tls_dir.mkdir(mode=0o700, exist_ok=True)

    credentials = ROOT / "scripts/remote-gateway/credentials"
    try:
        run(
            [sys.executable, str(credentials), "lab-tls",
             "--directory", str(tls_dir), "--hostname", args.hostname,
             "--alt-hostname", "localhost", "--alt-hostname", "127.0.0.1"],
            label="Generating TLS certificates"
        )
    except (subprocess.CalledProcessError, FileNotFoundError):
        print("  WARN: credentials helper failed; generating self-signed cert with openssl", flush=True)
        logger.warning("credentials helper failed; fallback to openssl")
        subprocess.run([
            "openssl", "req", "-x509", "-newkey", "rsa:3072", "-nodes",
            "-sha256", "-days", "30", "-subj", f"/CN={args.hostname}",
            "-keyout", str(tls_dir / "server-key.pem"), "-out", str(tls_dir / "server.pem")
        ], check=True, cwd="/tmp", stdout=LOG_FD, stderr=LOG_FD)
        subprocess.run(
            ["openssl", "x509", "-in", str(tls_dir / "server.pem"), "-out", str(tls_dir / "ca.pem")],
            check=True, cwd="/tmp", stdout=LOG_FD, stderr=LOG_FD
        )

    for src, dst in [(tls_dir / "server.pem", "tls.pem"), (tls_dir / "server-key.pem", "tls-key.pem")]:
        if src.is_file():
            shutil.copyfile(src, bundle / dst)
            os.chmod(bundle / dst, 0o640)
        else:
            print(f"  WARN: TLS file missing: {src}", flush=True)
            logger.warning("TLS file missing: %s", src)
    (bundle / "gateway.json").write_text(json.dumps(gateway_config, indent=2) + "\n")
    os.chmod(bundle / "gateway.json", 0o640)

    ca_src = tls_dir / "ca.pem"
    if ca_src.is_file():
        shutil.copyfile(ca_src, deploy_dir / "ca.pem")
        os.chmod(deploy_dir / "ca.pem", 0o644)
    else:
        print(f"  WARN: CA missing {ca_src}", flush=True)
        logger.warning("CA missing %s", ca_src)

    def get_or_create_secret(name: str, length: int = 32) -> str:
        path = deploy_dir / name
        if path.is_file() and not args.from_scratch:
            return path.read_text().strip()
        value = secrets.token_urlsafe(length)
        path.write_text(value + "\n")
        os.chmod(path, 0o600)
        return value

    postgres_password: str = get_or_create_secret("postgres-password", 32)
    metering_password: str = get_or_create_secret("metering-password", 32)
    maas_password: str = get_or_create_secret("maas-password", 32)
    m2m_secret: str = get_or_create_secret("m2m-secret", 48)
    management_secret: str = get_or_create_secret("management-secret", 48)
    session_secret: str = get_or_create_secret("session-secret", 48)

    bootstrap_sql: str = postgres_bootstrap_sql(metering_password, maas_password)
    (initdb / "10-create-databases.sql").write_text(bootstrap_sql)
    os.chmod(initdb / "10-create-databases.sql", 0o640)

    (deploy_dir / "postgres.env").write_text(
        f"POSTGRES_USER=postgres\nPOSTGRES_DB=postgres\nPOSTGRES_PASSWORD={postgres_password}\nTZ=UTC\nPGTZ=UTC\n"
    )
    os.chmod(deploy_dir / "postgres.env", 0o600)

    metering_url: str = f"postgres://metering:{metering_password}@pricetag-db:5432/metering?sslmode=disable"
    maas_url: str = f"postgres://maas:{maas_password}@pricetag-db:5432/maas?sslmode=disable"

    # MaaS requires DB URL file to be regular file, not symlink (enforce).
    # If a previous deploy left a symlink, replace it with a regular file.
    maas_db_url_path = deploy_dir / "maas-db-url"
    if maas_db_url_path.is_symlink():
        try:
            maas_db_url_path.unlink()
        except OSError:
            pass
    maas_db_url_path.write_text(maas_url + "\n")
    os.chmod(maas_db_url_path, 0o600)
    # Verify it's regular file (lstat, not follow)
    try:
        if maas_db_url_path.is_symlink() or not maas_db_url_path.is_file():
            raise ValueError(f"{maas_db_url_path} must be regular file, not symlink")
    except OSError:
        pass

    (deploy_dir / "metering.env").write_text(
        "".join(f"{k}={v}\n" for k, v in {
            "DATABASE_URL": metering_url,
            "M2M_AUTH_REQUIRED": "true",
            "M2M_SHARED_SECRET": m2m_secret,
            "SESSION_SECRET": session_secret,
            "MANAGEMENT_API_SECRET": management_secret,
            "MANAGEMENT_PUBLIC_ORIGIN": f"https://{args.hostname}:8443",
            "WELCOME_GATEWAY_URL": f"https://{args.hostname}:8443",
            "WELCOME_DASHBOARD_URL": f"https://{args.hostname}:8443",
            "DEFAULT_KEY_EXPIRY_HOURS": "2160",
            "MAX_KEY_EXPIRY_HOURS": "2160",
            "GATEWAY_MODELS_FILE": "/etc/gateway-catalog/models.json",
            "KEY_SERVICE_URL": "http://pricetag-maas:8080",
            "KEY_SERVICE_USER_HEADER": "X-MaaS-Username",
            "KEY_SERVICE_GROUPS_HEADER": "X-MaaS-Group",
            "PARTNER_USER_KEY_GROUP": "system:authenticated",
            "SUPERADMIN_USERS": "admin",
            "MONTHLY_TOKEN_QUOTA": "10000000000",
            "TZ": "UTC",
            "MAAS_VALIDATE_URL": "http://pricetag-maas:8080/internal/v1/api-keys/validate",
        }.items())
    )
    os.chmod(deploy_dir / "metering.env", 0o600)

    (deploy_dir / "m2m-secret").write_text(m2m_secret + "\n")
    os.chmod(deploy_dir / "m2m-secret", 0o600)

    (deploy_dir / "bootstrap.json").write_text(json.dumps({"models": models, "sources": sources, "monthly_usd": args.monthly_usd}) + "\n")
    (deploy_dir / "models.json").write_text(json.dumps(models, indent=2) + "\n")
    (deploy_dir / "price-sources.json").write_text(json.dumps(sources, indent=2) + "\n")
    (catalog_dir / "models.json").write_text(json.dumps([{k: m[k] for k in ("id", "model", "provider")} for m in models]) + "\n")
    os.chmod(deploy_dir / "bootstrap.json", 0o640)
    os.chmod(deploy_dir / "models.json", 0o640)

    (deploy_dir / "sample-users").write_text("yes\n" if args.sample_users else "no\n")
    os.chmod(deploy_dir / "sample-users", 0o640)
    (deploy_dir / "admin-directory").write_text(str(admin_dir) + "\n")
    (deploy_dir / "management-secret").write_text(management_secret + "\n")
    os.chmod(deploy_dir / "management-secret", 0o600)

    # llm-katan echo does not need fixtures; but keep them for fixture/vllm fallback
    llm_katan_is_echo = getattr(args, "llm_katan_backend", "echo") == "echo"
    if not llm_katan_is_echo or True:  # always stage fixtures for fallback verification
        common_provider = ROOT / "tests/common/provider.py"
        pricetag_provider = ROOT / "tests/pricetag/provider.py"
        if common_provider.is_file():
            shutil.copyfile(common_provider, fixtures / "provider.py")
        if pricetag_provider.is_file():
            shutil.copyfile(pricetag_provider, fixtures / "run.py")
        if not (fixtures / "run.py").is_file() and (fixtures / "provider.py").is_file():
            shutil.copyfile(fixtures / "provider.py", fixtures / "run.py")

    # llm-katan synthetic env + secret hygiene (pricetag-mock-ui-v1)
    # Must match mock-guard: Secret=pricetag-mock-ui-v1,type=env,target=CUSTOM_MOCK_API_KEY
    llm_katan_env_src = ROOT / "configs/laptop/llm-katan.env"
    llm_katan_env_dst = deploy_dir / "llm-katan.env"
    if llm_katan_env_src.is_file():
        shutil.copyfile(llm_katan_env_src, llm_katan_env_dst)
        os.chmod(llm_katan_env_dst, 0o640)
    else:
        # Fallback minimal env
        llm_katan_env_dst.write_text(
            "LLM_KATAN_BACKEND=echo\nLLM_KATAN_PROVIDERS=openai,anthropic\n"
            "OPENAI_API_KEY=synthetic-openai\nCUSTOM_MOCK_API_KEY=synthetic-anthropic\n"
            "LLM_KATAN_ERROR_RATE=0.0\nLLM_KATAN_LATENCY_MS=0\n"
            "LLM_KATAN_TIMEOUT_AFTER=0\nLLM_KATAN_RATE_LIMIT_AFTER=0\n"
            "LLM_KATAN_MAX_INFLIGHT=0\nLLM_KATAN_CHUNK_DELAY_MS=0\n"
            "LLM_KATAN_TTFT_MS=0\nLLM_KATAN_ITL_MS=0\n"
        )
        os.chmod(llm_katan_env_dst, 0o640)

    # mock-secret for pricetag-mock-ui-v1 compose secret + gateway credential_injection
    # Compose secret pricetag-mock-ui-v1 -> file ./mock-secret -> env CUSTOM_MOCK_API_KEY
    mock_secret_file = deploy_dir / "mock-secret"
    if not mock_secret_file.is_file() or args.from_scratch:
        mock_secret_file.write_text("synthetic-anthropic\n")
        os.chmod(mock_secret_file, 0o600)

    # shims (responses shim + docs) - copy if present
    shim_src_dir = ROOT / "scripts/laptop/shims"
    if shim_src_dir.is_dir():
        shim_dst_dir = deploy_dir / "shims"
        shim_dst_dir.mkdir(mode=0o750, exist_ok=True)
        for item in shim_src_dir.iterdir():
            dst = shim_dst_dir / item.name
            if not dst.exists():
                shutil.copyfile(item, dst)
                os.chmod(dst, 0o644)

    compose_yaml: str = generate_compose_yaml(
        args, arch, gateway_config, models, sources,
        postgres_password, metering_password, maas_password,
        m2m_secret, management_secret, session_secret
    )
    (deploy_dir / "compose.laptop.yaml").write_text(compose_yaml)
    os.chmod(deploy_dir / "compose.laptop.yaml", 0o644)
    compose_path.write_text(compose_yaml)
    os.chmod(compose_path, 0o644)
    print(f"  Wrote {deploy_dir / 'compose.laptop.yaml'}", flush=True)
    print(f"  Wrote {compose_path} (repo root)", flush=True)
    logger.info("Wrote %s and %s", deploy_dir / "compose.laptop.yaml", compose_path)

    (deploy_dir / ".prepared").write_text(f"{time.time()}\n")

    return {
        "deploy_dir": deploy_dir,
        "admin_dir": admin_dir,
        "compose_path": compose_path,
        "bundle": bundle,
        "models": models,
        "sources": sources,
        "gateway_config": gateway_config,
    }


