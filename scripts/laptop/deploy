def install(args: argparse.Namespace) -> None:
    print("\nRemote gateway with PriceTag (laptop)\n" + "=" * 54)
    print(f"  Gateway    https://{args.hostname}:8443")
    print(f"  Mode       {args.mode} ({'mock provider (benchmark)' if args.mode == 'mock' else 'real providers'})")
    if args.demo_fixture:
        print("  Fixture    demo-fixture (two aliases)")
    llm_desc: str = f"{args.llm_katan_backend}" + (" (enabled)" if args.with_llm_katan else " (disabled)")
    print(f"  LLM-Katan  {llm_desc}")
    print(f"  Images     {args.image_mode}")
    print(f"  Praxis     {PRAXIS_IMAGE}")
    print(f"  Postgres   {POSTGRES_IMAGE}  ({POSTGRES_IMAGE_DIGEST})")
    print(f"  Hardened   {POSTGRES_HARDENED_PLACEHOLDER} (placeholder, not used on laptop)")
    print(f"  MaaS       {args.maas_image}")
    print(f"  PriceTag   {args.metering_image}")
    print(f"  Users      {'admin, alice, bob' if args.sample_users else 'admin only'}")
    print(f"  Budget     ${args.monthly_usd}/month per user")
    print(f"  Deploy     {args.deploy_dir}  (DEPLOY)")
    print(f"  Admin      {args.admin_dir}")
    print(f"  Compose    {args.compose_file}")
    print("")
    print("  1. Validate provider setup   4. Import images")
    print("  2. Prepare host              5. Configure gateway")
    print("  3. Acquire images            6. Start and verify services")
    if args.plan:
        print("\n[Plan] No host changes; would execute 6 stages above.", flush=True)
        if args.image_mode == "published":
            print(f"  Expected MaaS commit: {MAAS_COMMIT}", flush=True)
            print(f"  Expected PriceTag commit: {METERING_COMMIT}", flush=True)
        return

    stage(1, "Validate provider setup")
    arch: str = check_arch()
    check_podman()
    detect_compose()
    # Disk >=30% free check (requirement)
    check_disk_free(Path("/tmp"), required_pct=30.0)
    check_disk_free(Path.home(), required_pct=30.0)
    check_podman_machine_resources()

    if args.mode == "real":
        print("  Real provider validation: checking key files...", flush=True)
        for provider in args.provider:
            key_file: Path | None = getattr(args, f"{provider}_key_file")
            if key_file and not Path(key_file).is_absolute():
                raise ValueError(f"--{provider}-key-file must be absolute: {key_file}")
            if key_file and not Path(key_file).is_file():
                print(f"  WARN: key file not found yet: {key_file}", flush=True)

    if not args.yes:
        if sys.stdin.isatty():
            print(f"\nSetup validated. Ready to install to {args.deploy_dir} / {args.admin_dir}")
            answer: str = input("Install on this host? Type install: ").strip()
            if answer != "install":
                raise ValueError("installation cancelled (type 'install' to confirm)")

    os.umask(0o077)
    open_log()

    stage(2, "Prepare host")
    engine: str = "podman" if shutil.which("podman") else "docker"
    if args.from_scratch:
        print("  --from-scratch: will recreate volumes/networks and secrets (teardown)", flush=True)
        logger.info("--from-scratch teardown")
        try:
            compose_path_tmp: Path = args.compose_file.resolve() if args.compose_file.is_absolute() else (ROOT / args.compose_file)
            eng: list[str] = compose_engine()
            subprocess.run(eng + ["-f", str(compose_path_tmp), "down", "--remove-orphans", "-v"],
                           timeout=30, stdout=LOG_FD, stderr=LOG_FD, cwd="/tmp")
        except Exception as e:
            logger.debug("compose down failed: %s", e)
        for vol in VOLUME_NAMES:
            subprocess.run([engine, "volume", "rm", "-f", vol], timeout=10, stdout=LOG_FD, stderr=LOG_FD)
        for net in NETWORK_NAMES:
            subprocess.run([engine, "network", "rm", net], timeout=10, stdout=LOG_FD, stderr=LOG_FD)

    print("  Host prepared (Darwin podman machine: 10 vCPU / 16 GiB / 93 GiB Fedora 41 VM on M4 Pro 14c 48 GiB)", flush=True)
    logger.info("Host prepared")

    images: tuple[str, ...] = acquire_images(args, arch)

    import_ids: tuple[str, ...] = import_images(args, arch, images)

    state: dict[str, Any] = prepare_deployment(args, arch)
    # Attach import ids to state for potential use in compose (currently direct refs)
    state["import_ids"] = import_ids

    start_services(args, state)

    if args.verify:
        verify_deployment(args, state)

    print(f"\nNext: open https://{args.hostname}:8443/login (trust {state['deploy_dir'] / 'ca.pem'})", flush=True)
    print("Guide: docs/quickstarts/remote-gateway-pricetag/README.md", flush=True)
    if args.mode == "mock":
        print(f"Benchmark (20 req): python3 scripts/pricetag/perf run --model {state['models'][0]['id']} --url https://localhost:8443 --ca {state['deploy_dir'] / 'ca.pem'} --requests 20", flush=True)
        print(f"Benchmark full: sudo python3 scripts/pricetag/benchmark --requests 20  (requires RHEL layout; on laptop use perf)", flush=True)

    print("\nTeardown: scripts/laptop/teardown --purge-volumes  (or re-run with --from-scratch)", flush=True)


def main() -> None:
    if should_delegate_to_rhel():
        raw: list[str] = sys.argv[1:]
        laptop_only: set[str] = {"--from-scratch", "--verify", "--with-llm-katan", "--llm-katan-backend", "--llm-katan", "--deploy-dir", "--admin-dir", "--compose-file", "--no-pull"}
        filtered: list[str] = []
        skip_next: bool = False
        for arg in raw:
            if skip_next:
                skip_next = False
                continue
            bare: str = arg.split("=")[0]
            if bare in laptop_only:
                if "=" not in arg and bare in ("--llm-katan-backend", "--llm-katan", "--deploy-dir", "--admin-dir", "--compose-file"):
                    skip_next = True
                continue
            filtered.append(arg)
        sys.exit(delegate_to_install(filtered))

    args: argparse.Namespace = parse_args()

    if args.plan:
        install(args)
        return

    os.umask(0o077)
    lock_file: Path = LOCK_PATH
    lock_file.parent.mkdir(parents=True, exist_ok=True)
    fd: int = os.open(str(lock_file), os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    try:
        with os.fdopen(fd, "w") as lock:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                print(f"error: another laptop deploy is running (lock {lock_file})", file=sys.stderr)
                sys.exit(1)
            lock.write(f"{os.getpid()}\n{time.time()}\n")
            lock.flush()
            install(args)
    except (OSError, ValueError, RuntimeError, subprocess.CalledProcessError, KeyboardInterrupt) as error:
        print(f"\nDeploy stopped during: {STAGE}", file=sys.stderr)
        print(str(error) or type(error).__name__, file=sys.stderr)
        if LOG_PATH:
            print(f"Details: tail -n 100 {LOG_PATH}", file=sys.stderr)
        print("No volumes were automatically deleted (use --from-scratch to purge). "
              "Fix the failed stage and rerun; if configuration was prepared, inspect it before starting.", file=sys.stderr)
        sys.exit(1)
    finally:
        if LOG_FD is not None:
            try:
                LOG_FD.close()
            except Exception:
                pass


if __name__ == "__main__":
    try:
        main()
    except EOFError:
        print("\nDeploy cancelled (EOF)", file=sys.stderr)
        sys.exit(1)
