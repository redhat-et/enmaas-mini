# llm-katan.env - laptop (MBP/Darwin) synthetic provider configuration
# Consumed by compose.laptop.yaml llm-katan service (ghcr.io/yossiovadia/llm-katan:0.22.0).
# All failure injection flags are disabled by default so that benchmark verification
# has deterministic pass/fail semantics. Override per-request via query params if needed.
#
# Provider APIs exposed on :8000:
#   openai    -> POST /v1/chat/completions, GET /v1/models  (Authorization: Bearer <key>)
#   anthropic -> POST /v1/messages                           (x-api-key: <key>)
# Missing (shimmed or documented): /v1/responses, /v1/messages/count_tokens
# Dashboard (host-only): http://127.0.0.1:8000/dashboard
# Never commit real provider keys here; these are synthetic values for mock mode only.

# ---- Backend ---------------------------------------------------------------
# Echo returns request metadata without model download / GPU / torch.
LLM_KATAN_BACKEND=echo
LLM_KATAN_MODEL=fixture
# Served model name visible in OpenAI/Anthropic responses; must match PriceTag catalog.
LLM_KATAN_SERVED_MODEL_NAME=fixture
LLM_KATAN_PORT=8000

# ---- Provider selection ----------------------------------------------------
# Subset actually wired in gateway; keep in sync with scripts/pricetag/demo_config.py
LLM_KATAN_PROVIDERS=openai,anthropic

# ---- Synthetic credentials -------------------------------------------------
# Must match gateway credential_injection expectations:
#   openai    -> OPENAI_API_KEY / Authorization: Bearer synthetic-openai
#   anthropic -> CUSTOM_MOCK_API_KEY / x-api-key: synthetic-anthropic
OPENAI_API_KEY=synthetic-openai
CUSTOM_MOCK_API_KEY=synthetic-anthropic
# llm-katan --api-keys override (comma-separated openai=...,anthropic=...)
LLM_KATAN_API_KEYS=openai=synthetic-openai,anthropic=synthetic-anthropic

# ---- Failure injection (all disabled by default) ---------------------------
# Benchmark expects deterministic 2xx. Enable explicitly for resilience tests:
#   podman exec llm-katan env LLM_KATAN_ERROR_RATE=0.3 llm-katan ...
# or override via compose env_file.
LLM_KATAN_ERROR_RATE=0.0
LLM_KATAN_LATENCY_MS=0
LLM_KATAN_TIMEOUT_AFTER=0
LLM_KATAN_RATE_LIMIT_AFTER=0
LLM_KATAN_MAX_INFLIGHT=0
LLM_KATAN_CHUNK_DELAY_MS=0
LLM_KATAN_TTFT_MS=0
LLM_KATAN_ITL_MS=0

# ---- Stats / dashboard -----------------------------------------------------
# Persist stats across restarts; mount a volume if durability is required.
LLM_KATAN_STATS_FILE=/tmp/llm-katan-stats.json
# Uvicorn workers: 1 keeps dashboard WebSocket; >1 requires --disable-dashboard.
LLM_KATAN_WORKERS=1
LLM_KATAN_LOG_LEVEL=info

# ---- Network binding -------------------------------------------------------
# Bind all interfaces inside the pricetag-mock network; gateway reaches
# pricetag-mock:8000. Dashboard is host-published on 127.0.0.1:8000 only.
LLM_KATAN_HOST=0.0.0.0

# ---- Known gaps (documented, not configured) -------------------------------
# /v1/responses      -> OpenAI Responses API; llm-katan does not implement it.
#                       See scripts/laptop/shims/README.md for shim/compat note.
# /v1/messages/count_tokens -> Anthropic token-count; not in llm-katan.
#                       Perf harness routes only /v1/chat/completions + /v1/messages.
# Token accounting   -> llm-katan echo uses word-count tokens (variable). The
#                       deterministic 2+3=5 fixture applies only to tests/common/provider.py.
#                       See shims/README.md "Deterministic tokens" for strategy.
