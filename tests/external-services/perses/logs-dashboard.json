{
  "kind": "Dashboard",
  "metadata": {
    "name": "enmaas-logs",
    "project": "praxis"
  },
  "spec": {
    "display": {
      "name": "enMAAS gateway \u2014 service events"
    },
    "duration": "15m",
    "panels": {
      "navigation": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Monitoring navigation"
          },
          "plugin": {
            "kind": "Markdown",
            "spec": {
              "text": "[Main monitoring](/projects/praxis/dashboards/enmaas-monitoring) \u00b7 [Gateway traffic](/projects/praxis/dashboards/enmaas-gateway) \u00b7 [Host](/projects/praxis/dashboards/enmaas-host) \u00b7 [Components](/projects/praxis/dashboards/enmaas-components) \u00b7 [Accounting / DB](/projects/praxis/dashboards/enmaas-accounting) \u00b7 [Alerts](/projects/praxis/dashboards/enmaas-alerts) \u00b7 [Inference traces](/projects/praxis/dashboards/enmaas-traces) \u00b7 [Service events](/projects/praxis/dashboards/enmaas-logs)"
            }
          }
        }
      },
      "0": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Sanitized service log events",
            "description": "Event time, service and severity. Original messages and sensitive attributes are removed before export; use SSH for full service diagnostics."
          },
          "plugin": {
            "kind": "LogsTable",
            "spec": {}
          },
          "queries": [
            {
              "kind": "LogQuery",
              "spec": {
                "plugin": {
                  "kind": "LokiLogQuery",
                  "spec": {
                    "datasource": {
                      "kind": "LokiDatasource",
                      "name": "loki"
                    },
                    "query": "{service_name=~\".+\"}"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "layouts": [
      {
        "kind": "Grid",
        "spec": {
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 24,
              "height": 3,
              "content": {
                "$ref": "#/spec/panels/navigation"
              }
            },
            {
              "x": 0,
              "y": 3,
              "width": 24,
              "height": 16,
              "content": {
                "$ref": "#/spec/panels/0"
              }
            }
          ]
        }
      }
    ]
  }
}
