{
  "kind": "Dashboard",
  "metadata": {
    "name": "enmaas-traces",
    "project": "praxis"
  },
  "spec": {
    "display": {
      "name": "enMAAS gateway \u2014 traces"
    },
    "duration": "1h",
    "panels": {
      "navigation": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Monitoring navigation"
          },
          "plugin": {
            "kind": "Markdown",
            "spec": {
              "text": "[Main monitoring](/projects/praxis/dashboards/enmaas-monitoring) \u00b7 [Gateway traffic](/projects/praxis/dashboards/enmaas-gateway) \u00b7 [Host](/projects/praxis/dashboards/enmaas-host) \u00b7 [Components](/projects/praxis/dashboards/enmaas-components) \u00b7 [Accounting / DB](/projects/praxis/dashboards/enmaas-accounting) \u00b7 [Alerts](/projects/praxis/dashboards/enmaas-alerts) \u00b7 [Inference traces](/projects/praxis/dashboards/enmaas-traces) \u00b7 [Service events](/projects/praxis/dashboards/enmaas-logs)"
            }
          }
        }
      },
      "0": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Recent inference traces",
            "description": "Sampled request traces. Sensitive names and attributes are removed before storage. Click a trace to inspect its duration and spans; absence does not prove no request occurred."
          },
          "plugin": {
            "kind": "TraceTable",
            "spec": {
              "links": {
                "trace": "/projects/praxis/dashboards/enmaas-trace-detail?var-traceId=${traceId}"
              }
            }
          },
          "queries": [
            {
              "kind": "TraceQuery",
              "spec": {
                "plugin": {
                  "kind": "TempoTraceQuery",
                  "spec": {
                    "datasource": {
                      "kind": "TempoDatasource",
                      "name": "tempo"
                    },
                    "query": "{resource.service.name =~ \"enmaas-gateway.*\" && span.enmaas.request.kind = \"inference\"}"
                  }
                }
              }
            }
          ]
        }
      },
      "errors": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Failed inference traces",
            "description": "Sampled inference spans marked as errors. This is not a count of HTTP 5xx responses: inspect each trace status and timing. The table may be empty even when gateway errors occurred, because traces are sampled."
          },
          "plugin": {
            "kind": "TraceTable",
            "spec": {
              "links": {
                "trace": "/projects/praxis/dashboards/enmaas-trace-detail?var-traceId=${traceId}"
              }
            }
          },
          "queries": [
            {
              "kind": "TraceQuery",
              "spec": {
                "plugin": {
                  "kind": "TempoTraceQuery",
                  "spec": {
                    "datasource": {
                      "kind": "TempoDatasource",
                      "name": "tempo"
                    },
                    "query": "{resource.service.name =~ \"enmaas-gateway.*\" && span.enmaas.request.kind = \"inference\" && status = error}"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "layouts": [
      {
        "kind": "Grid",
        "spec": {
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 24,
              "height": 3,
              "content": {
                "$ref": "#/spec/panels/navigation"
              }
            },
            {
              "x": 0,
              "y": 3,
              "width": 24,
              "height": 16,
              "content": {
                "$ref": "#/spec/panels/0"
              }
            },
            {
              "x": 0,
              "y": 19,
              "width": 24,
              "height": 16,
              "content": {
                "$ref": "#/spec/panels/errors"
              }
            }
          ]
        }
      }
    ]
  }
}
