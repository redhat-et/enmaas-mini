{
  "kind": "Dashboard",
  "metadata": {
    "name": "enmaas-trace-detail",
    "project": "praxis"
  },
  "spec": {
    "display": {
      "name": "enMAAS gateway \u2014 trace detail"
    },
    "duration": "15m",
    "panels": {
      "0": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Request spans",
            "description": "Timing and sanitized attributes from the selected stored trace."
          },
          "plugin": {
            "kind": "TracingGanttChart",
            "spec": {}
          },
          "queries": [
            {
              "kind": "TraceQuery",
              "spec": {
                "plugin": {
                  "kind": "TempoTraceQuery",
                  "spec": {
                    "datasource": {
                      "kind": "TempoDatasource",
                      "name": "tempo"
                    },
                    "query": "${traceId}"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "layouts": [
      {
        "kind": "Grid",
        "spec": {
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 24,
              "height": 16,
              "content": {
                "$ref": "#/spec/panels/0"
              }
            }
          ]
        }
      }
    ],
    "variables": [
      {
        "kind": "TextVariable",
        "spec": {
          "name": "traceId",
          "value": "",
          "display": {
            "name": "Trace ID"
          }
        }
      }
    ]
  }
}
