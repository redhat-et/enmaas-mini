{
  "kind": "GlobalDatasource",
  "metadata": {
    "name": "tempo"
  },
  "spec": {
    "default": false,
    "plugin": {
      "kind": "TempoDatasource",
      "spec": {
        "proxy": {
          "kind": "HTTPProxy",
          "spec": {
            "url": "http://127.0.0.1:3200"
          }
        }
      }
    }
  }
}
