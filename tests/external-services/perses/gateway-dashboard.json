{
  "kind": "Dashboard",
  "metadata": {
    "name": "enmaas-gateway",
    "project": "praxis"
  },
  "spec": {
    "display": {
      "name": "enMAAS gateway \u2014 routed traffic"
    },
    "duration": "15m",
    "panels": {
      "navigation": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Monitoring navigation"
          },
          "plugin": {
            "kind": "Markdown",
            "spec": {
              "text": "[Main monitoring](/projects/praxis/dashboards/enmaas-monitoring) \u00b7 [Gateway traffic](/projects/praxis/dashboards/enmaas-gateway) \u00b7 [Host](/projects/praxis/dashboards/enmaas-host) \u00b7 [Components](/projects/praxis/dashboards/enmaas-components) \u00b7 [Accounting / DB](/projects/praxis/dashboards/enmaas-accounting) \u00b7 [Alerts](/projects/praxis/dashboards/enmaas-alerts) \u00b7 [Inference traces](/projects/praxis/dashboards/enmaas-traces) \u00b7 [Service events](/projects/praxis/dashboards/enmaas-logs)"
            }
          }
        }
      },
      "0": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Routed requests per second",
            "description": "Public-chain requests that reached a router; early pre-routing rejections are excluded."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "table",
                "position": "bottom",
                "values": [
                  "max"
                ]
              },
              "visual": {
                "areaOpacity": 0,
                "lineWidth": 2
              },
              "yAxis": {
                "format": {
                  "unit": "requests/sec",
                  "decimalPlaces": 2
                }
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum by (cluster, status_class) (rate(praxis_http_requests_total{cluster=~\"authenticated-openai|authenticated-anthropic|dashboard\"}[2m]))",
                    "seriesNameFormat": "{{cluster}} {{status_class}}"
                  }
                }
              }
            }
          ]
        }
      },
      "1": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Mean routed request duration",
            "description": "Mean completed duration by public route, including provider streaming time. Not a latency percentile or proxy overhead. Idle routes have undefined duration, not zero latency."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "table",
                "position": "bottom",
                "values": [
                  "max"
                ]
              },
              "visual": {
                "areaOpacity": 0,
                "lineWidth": 2
              },
              "yAxis": {
                "format": {
                  "unit": "seconds",
                  "decimalPlaces": 2
                }
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum by (cluster) (rate(praxis_http_request_duration_seconds_sum{cluster=~\"authenticated-openai|authenticated-anthropic|dashboard\"}[2m])) / (sum by (cluster) (rate(praxis_http_request_duration_seconds_count{cluster=~\"authenticated-openai|authenticated-anthropic|dashboard\"}[2m])))",
                    "seriesNameFormat": "{{cluster}}"
                  }
                }
              }
            }
          ]
        }
      },
      "2": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Active public requests",
            "description": "Requests active on the public HTTPS listener."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "table",
                "position": "bottom",
                "values": [
                  "max"
                ]
              },
              "visual": {
                "areaOpacity": 0,
                "lineWidth": 2
              },
              "yAxis": {
                "format": {
                  "unit": "decimal",
                  "decimalPlaces": 2,
                  "shortValues": true
                }
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "praxis_http_active_requests{listener=\"https\"}",
                    "seriesNameFormat": "Public HTTPS"
                  }
                }
              }
            }
          ]
        }
      },
      "3": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Gateway open file descriptors",
            "description": "Gateway process file descriptor count; this is not host CPU or memory usage."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "table",
                "position": "bottom",
                "values": [
                  "max"
                ]
              },
              "visual": {
                "areaOpacity": 0,
                "lineWidth": 2
              },
              "yAxis": {
                "format": {
                  "unit": "decimal",
                  "decimalPlaces": 2,
                  "shortValues": true
                }
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "praxis_process_open_fds",
                    "seriesNameFormat": "Open descriptors"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "layouts": [
      {
        "kind": "Grid",
        "spec": {
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 24,
              "height": 3,
              "content": {
                "$ref": "#/spec/panels/navigation"
              }
            },
            {
              "x": 0,
              "y": 3,
              "width": 12,
              "height": 10,
              "content": {
                "$ref": "#/spec/panels/0"
              }
            },
            {
              "x": 12,
              "y": 3,
              "width": 12,
              "height": 10,
              "content": {
                "$ref": "#/spec/panels/1"
              }
            },
            {
              "x": 0,
              "y": 13,
              "width": 12,
              "height": 10,
              "content": {
                "$ref": "#/spec/panels/2"
              }
            },
            {
              "x": 12,
              "y": 13,
              "width": 12,
              "height": 10,
              "content": {
                "$ref": "#/spec/panels/3"
              }
            }
          ]
        }
      }
    ]
  }
}
