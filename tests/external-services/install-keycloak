#!/usr/bin/env bash
# Dedicated RHEL test host only; no cloud security-group mutations.
set -euo pipefail
HERE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd -- "${HERE}/../.." && pwd)"
# shellcheck source=scripts/common/lib.sh
source "${ROOT}/scripts/common/lib.sh"
require_root
[[ "$#" -ge 5 ]] || die 'usage: install-keycloak INPUTS CERT KEY CA ALLOWED_IPV4_CIDR [ALLOWED_IPV4_CIDR...]'
inputs="$1"; cert="$2"; key="$3"; ca="$4"; shift 4
python3 - "$inputs" "$cert" "$key" "$ca" "$@" <<'PY'
import ipaddress,os,stat,sys
from pathlib import Path
root=Path(sys.argv[1])
for path in [root,root/'quadlets',*root.iterdir(),*(root/'quadlets').iterdir(),*map(Path,sys.argv[2:5])]:
    info=path.lstat()
    if path.is_symlink() or info.st_uid!=0 or info.st_mode&0o077 or not (stat.S_ISREG(info.st_mode) or stat.S_ISDIR(info.st_mode)):
        raise SystemExit('inputs must be root-owned private regular files/directories, without symlinks')
for cidr in sys.argv[5:]:
    network=ipaddress.IPv4Network(cidr,strict=True)
    if network.prefixlen<24:raise SystemExit('use explicit /24–/32 source networks for this test host')
PY
"${ROOT}/scripts/remote-gateway/credentials" check-tls --cert "$cert" --key "$key"
openssl verify -CAfile "$ca" "$cert" >/dev/null
issuer_ip="$(python3 - "$inputs" <<'PYCODE'
import json,sys,urllib.parse
from pathlib import Path
url=json.loads((Path(sys.argv[1])/'gateway-oidc.json').read_text())['issuer_url']
print(urllib.parse.urlsplit(url).hostname)
PYCODE
)"
if python3 - "$issuer_ip" <<'PYADDRESS'
import ipaddress,sys
try: ipaddress.IPv4Address(sys.argv[1])
except ValueError: raise SystemExit(1)
PYADDRESS
then
  openssl x509 -in "$cert" -noout -checkip "$issuer_ip" >/dev/null
else
  openssl x509 -in "$cert" -noout -checkhost "$issuer_ip" >/dev/null
fi
openssl x509 -in "$cert" -noout -checkhost localhost >/dev/null
[[ ! -e /etc/enmaas-keycloak-lab ]] || die 'existing lab installation; inspect it instead of overwriting credentials'
dnf install -y podman python3 python3-pyyaml openssl firewalld shadow-utils policycoreutils-python-utils >/dev/null
systemctl enable --now firewalld >/dev/null
firewall_args=()
for source in "$@"; do
  firewall_args+=(--allow-rule "rule family=ipv4 source address=${source} port port=8443 protocol=tcp accept")
done
python3 "${HERE}/firewall-preflight.py" "${firewall_args[@]}"
"${ROOT}/scripts/common/install" --prepare
# Pull for the host architecture and refuse an emulated/cached incompatible image.
arch="$(oci_architecture "$(uname -m)")"
while IFS= read -r image; do
  as_service podman pull --platform "linux/${arch}" "$image" >/dev/null
  image_platform="$(as_service podman image inspect "$image" --format '{{.Os}}/{{.Architecture}}')"
  require_linux_image_platform "$image" "${image_platform%%/*}" "${image_platform#*/}" "$arch"
done < <(python3 - "$inputs" <<'PYCODE'
from pathlib import Path
import sys
images={line.removeprefix('Image=') for path in (Path(sys.argv[1])/'quadlets').glob('*.container')
        for line in path.read_text().splitlines() if line.startswith('Image=')}
for image in sorted(images):print(image)
PYCODE
)
uid="$(service_uid)"
units="/etc/containers/systemd/users/${uid}"
for unit in lab-keycloak.network lab-keycloak-db.volume lab-keycloak-db.container lab-keycloak.container lab-keycloak-proxy.container; do
  [[ ! -e "${units}/${unit}" ]] || die "existing unit: ${unit}"
done
for name in lab-db-password lab-keycloak-config lab-keycloak-realm lab-keycloak-proxy-config lab-server-cert lab-server-key; do
  ! as_service podman secret inspect "$name" >/dev/null 2>&1 || die "existing secret: ${name}"
done
install -d -m 0700 /etc/enmaas-keycloak-lab
# A durable marker prevents blindly retrying partial credential creation.
printf 'Inspect units and secrets before retrying a partial installation.\n' >/etc/enmaas-keycloak-lab/install-state
create_secret() {
  as_service podman secret create "$1" - <"$2" >/dev/null
}
create_secret lab-db-password "${inputs}/db-password"
create_secret lab-keycloak-config "${inputs}/keycloak.conf"
create_secret lab-keycloak-realm "${inputs}/realm.json"
create_secret lab-keycloak-proxy-config "${inputs}/proxy.json"
create_secret lab-server-cert "$cert"
create_secret lab-server-key "$key"
for unit in "${inputs}"/quadlets/*; do install -m 0644 "$unit" "${units}/$(basename "$unit")"; done
as_service systemctl --user daemon-reload
for source in "$@"; do
  rule="rule family=ipv4 source address=${source} port port=8443 protocol=tcp accept"
  firewall-cmd --permanent --add-rich-rule="$rule" >/dev/null
  firewall-cmd --add-rich-rule="$rule" >/dev/null
done
python3 "${HERE}/firewall-preflight.py" "${firewall_args[@]}"
as_service systemctl --user start lab-keycloak-proxy.service
printf 'Services started. Verify issuer discovery, public admin denial and restart behavior before using the lab.\n'
printf 'Private management: SSH to this host; Keycloak administration HTTPS binds to 127.0.0.1:18443 only.\n'
