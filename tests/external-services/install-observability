#!/usr/bin/env bash
# Dedicated RHEL observation test host; never changes AWS resources.
set -euo pipefail
HERE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd -- "${HERE}/../.." && pwd)"
# shellcheck source=scripts/common/lib.sh
source "${ROOT}/scripts/common/lib.sh"
require_root
[[ "$#" -ge 8 ]] || die 'usage: install-observability INPUTS CERT KEY ISSUER_CA TELEMETRY_CA HOST_IP GATEWAY_CIDR BROWSER_CIDR [...]'
inputs="$1"; cert="$2"; key="$3"; issuer_ca="$4"; telemetry_ca="$5"; host_ip="$6"; gateway_cidr="$7"; shift 7
private_ip="$(python3 - "$HERE/observability-host.py" "$inputs" "$cert" "$key" "$issuer_ca" "$telemetry_ca" "$host_ip" "$gateway_cidr" "$@" <<'PY'
import importlib.util,ipaddress,json,stat,subprocess,sys
spec=importlib.util.spec_from_file_location('observation',sys.argv.pop(1))
observation=importlib.util.module_from_spec(spec);spec.loader.exec_module(observation)
from pathlib import Path
root=Path(sys.argv[1])
for path in [root,root/'quadlets',*root.iterdir(),*(root/'quadlets').iterdir(),*map(Path,sys.argv[2:6])]:
    info=path.lstat()
    if path.is_symlink() or info.st_uid!=0 or info.st_mode&0o077 or not (stat.S_ISREG(info.st_mode) or stat.S_ISDIR(info.st_mode)):
        raise SystemExit('inputs must be root-owned private regular files/directories without symlinks')
ipaddress.IPv4Address(sys.argv[6])
for cidr in sys.argv[7:]:
    if ipaddress.IPv4Network(cidr,strict=True).prefixlen<24:raise SystemExit('use explicit /24–/32 source networks')
gateway=ipaddress.IPv4Network(sys.argv[7],strict=True)
if gateway.prefixlen!=32:
    raise SystemExit('gateway telemetry source must be one private IPv4 /32')
observation.private_address(str(gateway.network_address))
interfaces=json.loads(subprocess.check_output(['ip','-j','-4','address','show'],text=True))
print(observation.validate_host_binding(root,interfaces))
PY
)"
"${ROOT}/scripts/remote-gateway/credentials" check-tls --cert "$cert" --key "$key"
openssl x509 -in "$cert" -noout -checkip "$host_ip" >/dev/null
openssl x509 -in "$cert" -noout -checkip "$private_ip" >/dev/null
openssl x509 -in "$issuer_ca" -noout >/dev/null
openssl x509 -in "$telemetry_ca" -noout >/dev/null
[[ ! -e /etc/enmaas-observability-lab ]] || die 'existing lab installation; inspect state instead of overwriting credentials'
dnf install -y podman python3 python3-pyyaml openssl firewalld shadow-utils policycoreutils-python-utils >/dev/null
systemctl enable --now firewalld >/dev/null
firewall_args=()
for source in "$@"; do
  firewall_args+=(--allow-rule "rule family=ipv4 source address=${source} port port=8443 protocol=tcp accept")
done
firewall_args+=(--allow-rule "rule family=ipv4 source address=${gateway_cidr} port port=24443 protocol=tcp accept")
python3 "${HERE}/firewall-preflight.py" "${firewall_args[@]}"
"${ROOT}/scripts/common/install" --prepare
uid="$(service_uid)"; units="/etc/containers/systemd/users/${uid}"
for unit in "${inputs}"/quadlets/*; do [[ ! -e "${units}/$(basename "$unit")" ]] || die 'existing observation unit'; done
arch="$(oci_architecture "$(uname -m)")"
while IFS= read -r image; do
  as_service podman pull --platform "linux/${arch}" "$image" >/dev/null
  image_platform="$(as_service podman image inspect "$image" --format '{{.Os}}/{{.Architecture}}')"
  require_linux_image_platform "$image" "${image_platform%%/*}" "${image_platform#*/}" "$arch"
done < <(sed -n 's/^Image=//p' "${inputs}"/quadlets/*.container | sort -u)
install -d -m 0700 /etc/enmaas-observability-lab
printf 'Inspect units and secrets before retrying a partial installation.\n' >/etc/enmaas-observability-lab/install-state
create_secret() {
  ! as_service podman secret inspect "$1" >/dev/null 2>&1 || die "existing secret: $1"
  as_service podman secret create "$1" - <"$2" >/dev/null
}
for filename in oauth.cfg perses.yaml prometheus.yaml loki.yaml tempo.yaml collector.yaml; do
  create_secret "lab-obs-${filename//./-}" "${inputs}/${filename}"
done
perses_assets="$(python3 - "$HERE/local.py" <<'PYASSETS'
import importlib.util,sys
spec=importlib.util.spec_from_file_location('lab',sys.argv[1])
lab=importlib.util.module_from_spec(spec);spec.loader.exec_module(lab)
print('\n'.join(lab.PERSES_ASSETS))
PYASSETS
)"
while IFS= read -r filename; do
  create_secret "lab-obs-${filename//./-}" "${inputs}/${filename}"
done <<< "$perses_assets"
create_secret lab-obs-server-cert "$cert"
create_secret lab-obs-server-key "$key"
create_secret lab-obs-issuer-ca "$issuer_ca"
create_secret lab-obs-telemetry-ca "$telemetry_ca"
for source in "$@"; do
  rule="rule family=ipv4 source address=${source} port port=8443 protocol=tcp accept"
  firewall-cmd --permanent --add-rich-rule="$rule" >/dev/null
  firewall-cmd --add-rich-rule="$rule" >/dev/null
done
rule="rule family=ipv4 source address=${gateway_cidr} port port=24443 protocol=tcp accept"
firewall-cmd --permanent --add-rich-rule="$rule" >/dev/null
firewall-cmd --add-rich-rule="$rule" >/dev/null
for unit in "${inputs}"/quadlets/*; do install -m 0644 "$unit" "${units}/$(basename "$unit")"; done
as_service systemctl --user daemon-reload
python3 "${HERE}/firewall-preflight.py" "${firewall_args[@]}"
as_service systemctl --user start lab-obs-perses.service lab-obs-prometheus.service lab-obs-loki.service \
  lab-obs-tempo.service lab-obs-collector.service lab-obs-auth.service
printf 'Services started; verify SSO denial/allowance, mTLS ingestion and private backend boundaries before acceptance.\n'
